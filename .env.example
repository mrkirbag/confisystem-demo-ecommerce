# ===========================================
# Turso (libSQL)
# 1. turso auth login
# 2. turso db create demo-ecommerce
# 3. turso db show demo-ecommerce --url
# 4. turso db tokens create demo-ecommerce
# 5. pnpm run db:seed-admin
# ===========================================
TURSO_DATABASE_URL=libsql://demo-ecommerce-TU_ORG.turso.io
TURSO_AUTH_TOKEN=

# Auth admin (JWT)
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio

# Seed admin: pnpm run db:seed-admin
ADMIN_EMAIL=admin@demo.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Administrador

# ===========================================
# Cloudflare R2 (imágenes)
# Keys:
#   logo/logo.webp
#   categorias/{slug}.webp
#   productos/{slug}/{slug}.webp
#   productos/{slug}/{slug}-2.webp
#   productos/{slug}/{slug}-3.webp
# La tienda solo usa S3_PUBLIC_URL (sin GetObject).
# ===========================================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
S3_BUCKET=
# S3_ENDPOINT = origin del API (SIN el nombre del bucket al final)
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_URL=https://pub-xxxxx.r2.dev
