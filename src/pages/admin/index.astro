---
import AdminLayout from '@/layouts/AdminLayout.astro';
import { getDb } from '@/lib/db';
import {
	getEstadisticasVentas,
	listPedidos,
	formatPrecio,
	formatFechaCorta,
} from '@/lib/pedidos';
import { getTiendaConfig } from '@/lib/tienda';
import { formatPrecioConMoneda } from '@/lib/tasas';
import { buildWhatsAppLink } from '@/lib/whatsapp';

export const prerender = false;

const admin = Astro.locals.admin!;
const db = getDb();

const [config, stats, pedidos] = await Promise.all([
	getTiendaConfig(),
	getEstadisticasVentas(),
	listPedidos(),
]);

let productosActivos = 0;
let stockTotalGlobal = 0;

try {
	const prodRes = await db.execute(`SELECT COUNT(*) AS total FROM productos WHERE activo = 1`);
	productosActivos = Number(prodRes.rows[0]?.total ?? 0);

	const stockRes = await db.execute(`
		SELECT COALESCE(SUM(v.stock), 0) AS total
		FROM producto_stock_variantes v
		INNER JOIN productos p ON p.id = v.producto_id
		WHERE p.activo = 1
	`);
	stockTotalGlobal = Number(stockRes.rows[0]?.total ?? 0);
} catch {
	// fallback silencioso
}

// Fecha formateada en español
const fechaRaw = new Intl.DateTimeFormat('es-VE', {
	weekday: 'long',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
}).format(new Date());
const fechaHoy = fechaRaw.charAt(0).toUpperCase() + fechaRaw.slice(1);

const storeName = config.nombre_tienda || 'Demo Tienda';
const tasaBcv = config.tasa_bcv ? Number(config.tasa_bcv) : null;
const tasaCop = config.tasa_cop ? Number(config.tasa_cop) : null;

// Conversiones de montos a bolívares
const montoConfirmadasBs = tasaBcv
	? formatPrecioConMoneda(stats.montoConfirmadas, 'VES', { tasa_bcv: tasaBcv, tasa_cop: tasaCop })
	: null;
const montoPendientesBs = tasaBcv
	? formatPrecioConMoneda(stats.montoPendientes, 'VES', { tasa_bcv: tasaBcv, tasa_cop: tasaCop })
	: null;

// Pedidos recientes (primeros 5)
const pedidosRecientes = pedidos.slice(0, 5);

// Datos para ApexCharts: Flujo de ventas
const now = new Date();
const last7Days = Array.from({ length: 7 }).map((_, idx) => {
	const d = new Date(now);
	d.setDate(d.getDate() - (6 - idx));
	return new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'short' }).format(d);
});

const chartFlujoData =
	stats.flujoAprobadas.length > 0
		? {
				categories: stats.flujoAprobadas.map((p) => p.label || p.fecha),
				series: stats.flujoAprobadas.map((p) => Number(p.monto.toFixed(2))),
				counts: stats.flujoAprobadas.map((p) => p.cantidad),
				hasRealData: true,
			}
		: {
				categories: last7Days,
				series: [0, 0, 0, 0, 0, 0, 0],
				counts: [0, 0, 0, 0, 0, 0, 0],
				hasRealData: false,
			};

const totalPedidos = stats.totalConfirmadas + stats.totalPendientes + stats.totalCanceladas;
const chartDonutData = {
	series: [stats.totalConfirmadas, stats.totalPendientes, stats.totalCanceladas],
	labels: ['Aprobadas', 'Pendientes', 'Canceladas'],
	colors: ['#10b981', '#f59e0b', '#ef4444'],
	total: totalPedidos,
};

function initials(name: string) {
	const p = (name || '').trim().split(/\s+/).filter(Boolean);
	if (p.length === 0) return 'CL';
	if (p.length === 1) return p[0].slice(0, 2).toUpperCase();
	return `${p[0][0]}${p[1][0]}`.toUpperCase();
}
---

<AdminLayout title="Panel de Control">
	<section class="dash-page orders-page" data-dashboard-page>
		<!-- 1. Hero / Header de Bienvenida con Estado en Vivo y Tasas (Sin letras amarillas) -->
		<div class="dash-hero">
			<div class="dash-hero__left">
				<div class="dash-hero__kicker">
					<span class="dash-status-dot" aria-hidden="true"></span>
					<span>Tienda Operativa · {storeName}</span>
				</div>
				<h1 class="dash-hero__title">¡Hola, {admin.nombre}!</h1>
				<p class="dash-hero__date">{fechaHoy}</p>
			</div>

			<div class="dash-hero__right">
				<!-- Widget de Tasas de Cambio en Vivo -->
				<div class="dash-rates-bar" title="Tasas de cambio activas de la tienda">
					<div class="dash-rates-bar__item">
						<span class="dash-rates-bar__label">Tasa Dólar:</span>
						<span class="dash-rates-bar__val">
							{tasaBcv ? `Bs. ${tasaBcv.toLocaleString('es-VE')}` : 'No definida'}
						</span>
					</div>
					<span class="dash-rates-bar__sep" aria-hidden="true"></span>
					<div class="dash-rates-bar__item">
						<span class="dash-rates-bar__label">Pesos COP:</span>
						<span class="dash-rates-bar__val">
							{tasaCop ? `$ ${tasaCop.toLocaleString('es-CO')}` : 'No definida'}
						</span>
					</div>
					<a
						href="/admin/configuracion/tienda"
						class="dash-rates-bar__edit"
						title="Ajustar tasas de cambio"
						aria-label="Ajustar tasas de cambio"
					>
						<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M12 20h9"></path>
							<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
						</svg>
					</a>
				</div>

				<!-- Botón Catálogo con fondo accent destacado y texto legible -->
				<a href="/admin/catalogo/productos" class="dash-btn-accent">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<line x1="12" y1="5" x2="12" y2="19"></line>
						<line x1="5" y1="12" x2="19" y2="12"></line>
					</svg>
					Catálogo de Productos
				</a>

				<a
					href="/"
					target="_blank"
					rel="noopener noreferrer"
					class="dash-btn-ghost"
					title="Abrir la tienda virtual pública"
				>
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
						<polyline points="15 3 21 3 21 9"></polyline>
						<line x1="10" y1="14" x2="21" y2="3"></line>
					</svg>
					Ver Tienda
				</a>
			</div>
		</div>

		<!-- 2. Grid de Métricas Principales (4 KPI Cards legibles) -->
		<div class="dash-kpis">
			<!-- KPI 1: Ingresos Aprobados -->
			<a href="/admin/estadisticas" class="dash-kpi dash-kpi--success" title="Ver reporte de ingresos">
				<div class="dash-kpi__top">
					<span class="dash-kpi__label">Ingresos Aprobados</span>
					<div class="dash-kpi__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="12" y1="1" x2="12" y2="23"></line>
							<path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
						</svg>
					</div>
				</div>
				<div class="dash-kpi__body">
					<strong class="dash-kpi__val">{formatPrecio(stats.montoConfirmadas)}</strong>
					{montoConfirmadasBs && (
						<span class="dash-kpi__subval">≈ {montoConfirmadasBs}</span>
					)}
				</div>
				<div class="dash-kpi__foot">
					<span class="dash-kpi__badge dash-kpi__badge--success">
						{stats.totalConfirmadas} {stats.totalConfirmadas === 1 ? 'venta aprobada' : 'ventas aprobadas'}
					</span>
					<span class="dash-kpi__link-text">Ver balance →</span>
				</div>
			</a>

			<!-- KPI 2: Pedidos Pendientes -->
			<a href="/admin/pedidos" class="dash-kpi dash-kpi--warning" title="Ver pedidos pendientes de aprobación">
				<div class="dash-kpi__top">
					<span class="dash-kpi__label">Por Confirmar</span>
					<div class="dash-kpi__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<polyline points="12 6 12 12 16 14"></polyline>
						</svg>
					</div>
				</div>
				<div class="dash-kpi__body">
					<strong class="dash-kpi__val">{stats.totalPendientes}</strong>
					<span class="dash-kpi__subval">
						{stats.totalPendientes > 0
							? `${formatPrecio(stats.montoPendientes)} en espera`
							: 'Sin pedidos pendientes'}
					</span>
				</div>
				<div class="dash-kpi__foot">
					{stats.totalPendientes > 0 ? (
						<span class="dash-kpi__badge dash-kpi__badge--warning">
							¡Atención requerida!
						</span>
					) : (
						<span class="dash-kpi__badge dash-kpi__badge--success">
							✓ Al día
						</span>
					)}
					<span class="dash-kpi__link-text">Gestionar →</span>
				</div>
			</a>

			<!-- KPI 3: Ticket Promedio y Efectividad -->
			<a href="/admin/estadisticas" class="dash-kpi dash-kpi--info" title="Ver métricas de conversión">
				<div class="dash-kpi__top">
					<span class="dash-kpi__label">Ticket Promedio</span>
					<div class="dash-kpi__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
							<polyline points="16 7 22 7 22 13"></polyline>
						</svg>
					</div>
				</div>
				<div class="dash-kpi__body">
					<strong class="dash-kpi__val">{formatPrecio(stats.ticketPromedio)}</strong>
					<span class="dash-kpi__subval">
						Efectividad: {stats.tasaEfectividad}%
					</span>
				</div>
				<div class="dash-kpi__foot">
					<span class="dash-kpi__badge dash-kpi__badge--info">
						{stats.totalCanceladas} {stats.totalCanceladas === 1 ? 'cancelada' : 'canceladas'}
					</span>
					<span class="dash-kpi__link-text">Rendimiento →</span>
				</div>
			</a>

			<!-- KPI 4: Catálogo y Stock Total -->
			<a href="/admin/catalogo/productos" class="dash-kpi dash-kpi--purple" title="Ver inventario de productos">
				<div class="dash-kpi__top">
					<span class="dash-kpi__label">Productos Activos</span>
					<div class="dash-kpi__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
							<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
							<line x1="12" y1="22.08" x2="12" y2="12"></line>
						</svg>
					</div>
				</div>
				<div class="dash-kpi__body">
					<strong class="dash-kpi__val">{productosActivos}</strong>
					<span class="dash-kpi__subval">{stockTotalGlobal} unidades disponibles</span>
				</div>
				<div class="dash-kpi__foot">
					{stats.agotados.length > 0 ? (
						<span class="dash-kpi__badge dash-kpi__badge--warning">
							{stats.agotados.length} agotados
						</span>
					) : (
						<span class="dash-kpi__badge dash-kpi__badge--success">
							Inventario en regla
						</span>
					)}
					<span class="dash-kpi__link-text">Catálogo →</span>
				</div>
			</a>
		</div>

		<!-- 3. Sección de Gráficos Interactivos (ApexCharts) -->
		<div class="dash-charts-grid">
			<!-- Gráfico 1: Flujo de Dinero / Ingresos en el Tiempo -->
			<div class="dash-chart-card">
				<div class="dash-chart-card__head">
					<div>
						<h2 class="dash-chart-card__title">Evolución de Ingresos y Ventas</h2>
						<p class="dash-chart-card__subtitle">
							Comportamiento diario de cobros aprobados en la tienda virtual
						</p>
					</div>
					<span class="dash-chart-pill">
						{chartFlujoData.hasRealData
							? `${formatPrecio(stats.montoConfirmadas)} facturado`
							: 'En espera de ventas'}
					</span>
				</div>

				<div class="dash-chart-body">
					<div id="dash-chart-flujo" class="dash-chart-target"></div>
				</div>
			</div>

			<!-- Gráfico 2: Distribución de Pedidos por Estado -->
			<div class="dash-chart-card">
				<div class="dash-chart-card__head">
					<div>
						<h2 class="dash-chart-card__title">Estado de Pedidos</h2>
						<p class="dash-chart-card__subtitle">
							Proporción global según estado del pedido
						</p>
					</div>
					<span class="dash-chart-pill">
						{totalPedidos} {totalPedidos === 1 ? 'pedido total' : 'pedidos totales'}
					</span>
				</div>

				<div class="dash-chart-body">
					<div id="dash-chart-donut" class="dash-chart-target"></div>
				</div>
			</div>
		</div>

		<!-- 4. Accesos Rápidos (Shortcuts de Gestión) -->
		<div class="dash-shortcuts-section">
			<h2 class="dash-section-title">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="color:#0f172a;">
					<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
				</svg>
				Accesos Rápidos
			</h2>

			<div class="dash-shortcuts-grid">
				<a href="/admin/catalogo/productos" class="dash-shortcut-card" style="--sc-accent:#0f766e;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
							<polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
							<line x1="12" y1="22.08" x2="12" y2="12"></line>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Productos</span>
						<span class="dash-shortcut-card__desc">Inventario, fotos y precios</span>
					</div>
				</a>

				<a href="/admin/pedidos" class="dash-shortcut-card" style="--sc-accent:#f59e0b;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
							<line x1="16" y1="13" x2="8" y2="13"></line>
							<line x1="16" y1="17" x2="8" y2="17"></line>
							<polyline points="10 9 9 9 8 9"></polyline>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Gestión Pedidos</span>
						<span class="dash-shortcut-card__desc">Aprobar pagos y despachos</span>
					</div>
				</a>

				<a href="/admin/estadisticas" class="dash-shortcut-card" style="--sc-accent:#3b82f6;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<line x1="18" y1="20" x2="18" y2="10"></line>
							<line x1="12" y1="20" x2="12" y2="4"></line>
							<line x1="6" y1="20" x2="6" y2="14"></line>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Estadísticas</span>
						<span class="dash-shortcut-card__desc">Balances y reporte imprimible</span>
					</div>
				</a>

				<a href="/admin/configuracion/tienda" class="dash-shortcut-card" style="--sc-accent:#10b981;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="3"></circle>
							<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Tasas y Monedas</span>
						<span class="dash-shortcut-card__desc">Configurar Tasa Dólar y Pesos COP</span>
					</div>
				</a>

				<a href="/admin/configuracion/identidad-visual" class="dash-shortcut-card" style="--sc-accent:#ec4899;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="13.5" cy="6.5" r=".5"></circle>
							<circle cx="17.5" cy="10.5" r=".5"></circle>
							<circle cx="8.5" cy="7.5" r=".5"></circle>
							<circle cx="6.5" cy="12.5" r=".5"></circle>
							<path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"></path>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Identidad Visual</span>
						<span class="dash-shortcut-card__desc">Colores, tipografías y logo</span>
					</div>
				</a>

				<a href="/admin/manual-de-usuario" class="dash-shortcut-card" style="--sc-accent:#8b5cf6;">
					<div class="dash-shortcut-card__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
							<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
						</svg>
					</div>
					<div class="dash-shortcut-card__info">
						<span class="dash-shortcut-card__title">Manual de Uso</span>
						<span class="dash-shortcut-card__desc">Guía para el comerciante</span>
					</div>
				</a>
			</div>
		</div>

		<!-- 5. Alertas de Inventario con Campanita (Diseño limpio con botones Gestionar) -->
		<div class="dash-inventory-alert-box">
			<div class="dash-inventory-alert-box__head">
				<div class="dash-inventory-alert-box__title-group">
					<div class="dash-bell-icon-wrap" aria-hidden="true">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
							<path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
						</svg>
						{(stats.agotados.length > 0 || stats.bajaExistencia.length > 0) && (
							<span class="dash-bell-dot"></span>
						)}
					</div>
					<div>
						<h3 class="dash-inventory-alert-box__title">Alertas de Inventario</h3>
						<p class="dash-inventory-alert-box__desc">Atención rápida para reponer existencias y evitar quiebres de catálogo</p>
					</div>
				</div>
			</div>

			<div class="dash-inventory-alert-box__cards">
				<!-- Tarjeta 1: Poco Stock -->
				<div class="dash-alert-tile dash-alert-tile--warning">
					<div class="dash-alert-tile__info">
						<span class="dash-alert-tile__badge">{stats.bajaExistencia.length}</span>
						<div class="dash-alert-tile__text">
							<strong>{stats.bajaExistencia.length} {stats.bajaExistencia.length === 1 ? 'producto con poco stock' : 'productos con poco stock'}</strong>
							<span>Existencia crítica (entre 1 y 5 unidades disponibles)</span>
						</div>
					</div>
					<a href="/admin/catalogo/productos" class="dash-alert-tile__btn">
						Gestionar
					</a>
				</div>

				<!-- Tarjeta 2: Agotados -->
				<div class="dash-alert-tile dash-alert-tile--danger">
					<div class="dash-alert-tile__info">
						<span class="dash-alert-tile__badge">{stats.agotados.length}</span>
						<div class="dash-alert-tile__text">
							<strong>{stats.agotados.length} {stats.agotados.length === 1 ? 'producto agotado' : 'productos agotados'}</strong>
							<span>Sin disponibilidad para la venta (0 existencias)</span>
						</div>
					</div>
					<a href="/admin/catalogo/productos" class="dash-alert-tile__btn">
						Gestionar
					</a>
				</div>
			</div>
		</div>

		<!-- 6. Bandeja de Pedidos Recientes (Máximo Protagonismo) -->
		<div class="dash-orders-panel">
			<div class="dash-orders-panel__head">
				<div class="dash-orders-panel__title-group">
					<div class="dash-orders-panel__icon" aria-hidden="true">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
							<polyline points="14 2 14 8 20 8"></polyline>
							<line x1="16" y1="13" x2="8" y2="13"></line>
							<line x1="16" y1="17" x2="8" y2="17"></line>
							<polyline points="10 9 9 9 8 9"></polyline>
						</svg>
					</div>
					<div>
						<h2 class="dash-orders-panel__title">Bandeja de Pedidos Recientes</h2>
						<p class="dash-orders-panel__subtitle">Últimas órdenes registradas para validación de pago, facturación y despacho</p>
					</div>
				</div>
				<a href="/admin/pedidos" class="dash-btn-ghost">
					Ver todos los pedidos ({pedidos.length})
				</a>
			</div>

			<div class="dash-orders-panel__body">
				{pedidosRecientes.length === 0 ? (
					<div class="dash-empty-orders">
						<div class="dash-empty-orders__icon" aria-hidden="true">
							<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="12" y1="8" x2="12" y2="12"></line>
								<line x1="12" y1="16" x2="12.01" y2="16"></line>
							</svg>
						</div>
						<p style="font-weight:700;font-size:1.05rem;color:#0f172a;margin:0;">No hay pedidos registrados aún</p>
						<p style="font-size:0.88rem;color:#64748b;margin:0;max-width:380px;">
							Cuando tus clientes completen una compra por la tienda web o WhatsApp, aparecerán aquí con todas sus especificaciones.
						</p>
					</div>
				) : (
					<div class="dash-orders-list">
						{pedidosRecientes.map((p) => {
							const waLink = buildWhatsAppLink(p.cliente_telefono);
							const statusBadge =
								p.estado === 'confirmada'
									? 'is-success'
									: p.estado === 'pendiente'
										? 'is-warning'
										: 'is-danger';
							const statusLabel =
								p.estado === 'confirmada'
									? 'Aprobada'
									: p.estado === 'pendiente'
										? 'Pendiente'
										: 'Cancelada';

							return (
								<div class="dash-order-item">
									<div class="dash-order-item__left">
										<span class="dash-order-avatar-mini" aria-hidden="true">
											{initials(p.cliente_nombre)}
										</span>
										<div class="dash-order-info-block">
											<div class="dash-order-headline">
												<span class="dash-order-id-pill">#{p.codigo}</span>
												<span class="dash-order-dot" aria-hidden="true">·</span>
												<span class="dash-order-client-name">{p.cliente_nombre}</span>
												{waLink && (
													<a
														href={waLink}
														target="_blank"
														rel="noopener noreferrer"
														class="dash-order-wa-link"
														title="Conversar por WhatsApp"
													>
														<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
															<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
														</svg>
													</a>
												)}
											</div>
											<div class="dash-order-meta">
												<span>{formatFechaCorta(p.creado_en)}</span>
												{p.cliente_telefono && (
													<>
														<span class="dash-order-dot" aria-hidden="true">·</span>
														<span>{p.cliente_telefono}</span>
													</>
												)}
											</div>
										</div>
									</div>

									<div class="dash-order-item__right">
										<div class="dash-order-money-block">
											<span class="dash-order-money-main">{formatPrecio(p.total)}</span>
											{tasaBcv && (
												<span class="dash-order-money-bs">
													{formatPrecioConMoneda(p.total, 'VES', { tasa_bcv: tasaBcv, tasa_cop: tasaCop })}
												</span>
											)}
										</div>
										<span class:list={['order-badge', statusBadge]}>
											{statusLabel}
										</span>
										<a
											href={`/admin/pedidos/${p.id}`}
											class="dash-btn-ghost"
											style="padding:0.4rem 0.85rem;font-size:0.82rem;"
										>
											Ver
										</a>
									</div>
								</div>
							);
						})}
					</div>
				)}
			</div>

			<div class="dash-orders-panel__foot">
				<span class="dash-orders-panel__count">
					Mostrando los {pedidosRecientes.length} pedidos más recientes de un total de {pedidos.length}
				</span>
				<a href="/admin/pedidos" class="dash-orders-panel__link">
					Ir a la gestión completa de pedidos →
				</a>
			</div>
		</div>
	</section>
</AdminLayout>

<script
	is:inline
	define:vars={{
		chartFlujoData,
		chartDonutData,
	}}
>
	window.__DASH_CHARTS_DATA__ = {
		chartFlujoData,
		chartDonutData,
	};
</script>

<script>
	import ApexCharts from 'apexcharts';

	function initDashboardCharts() {
		const page = document.querySelector('[data-dashboard-page]');
		if (!page) return;

		const data = (window as any).__DASH_CHARTS_DATA__;
		if (!data) return;

		// 1. Gráfico de Flujo de Ingresos (Smooth Area)
		const flujoEl = document.getElementById('dash-chart-flujo');
		if (flujoEl) {
			flujoEl.innerHTML = '';
			const optionsFlujo = {
				chart: {
					type: 'area',
					height: 290,
					toolbar: { show: false },
					zoom: { enabled: false },
					fontFamily: 'inherit',
					background: 'transparent',
				},
				theme: { mode: 'light' },
				colors: ['#0f766e'],
				stroke: { curve: 'smooth', width: 3 },
				fill: {
					type: 'gradient',
					gradient: {
						shadeIntensity: 1,
						opacityFrom: 0.45,
						opacityTo: 0.05,
						stops: [0, 90, 100],
					},
				},
				dataLabels: { enabled: false },
				series: [
					{
						name: 'Ventas Aprobadas ($)',
						data: data.chartFlujoData.series,
					},
				],
				xaxis: {
					categories: data.chartFlujoData.categories,
					labels: {
						style: {
							colors: '#64748b',
							fontSize: '11px',
							fontWeight: 600,
						},
					},
					axisBorder: { show: false },
					axisTicks: { show: false },
				},
				yaxis: {
					labels: {
						style: {
							colors: '#64748b',
							fontSize: '11px',
							fontWeight: 600,
						},
						formatter: (val: any) =>
							'$' +
							Number(val).toLocaleString('en-US', {
								minimumFractionDigits: 0,
								maximumFractionDigits: 0,
							}),
					},
				},
				grid: {
					borderColor: 'rgba(0, 0, 0, 0.06)',
					strokeDashArray: 4,
				},
				tooltip: {
					theme: 'light',
					y: {
						formatter: (val: any, opt?: any) => {
							const idx = opt?.dataPointIndex ?? 0;
							const cant = data.chartFlujoData.counts[idx] || 0;
							return `$${Number(val).toFixed(2)} (${cant} ${cant === 1 ? 'pedido' : 'pedidos'})`;
						},
					},
				},
			};
			const chartFlujo = new (ApexCharts as any)(flujoEl, optionsFlujo);
			chartFlujo.render();
		}

		// 2. Gráfico Donut de Estados
		const donutEl = document.getElementById('dash-chart-donut');
		if (donutEl) {
			donutEl.innerHTML = '';
			const totalOrders = data.chartDonutData.total;
			const seriesData = totalOrders > 0 ? data.chartDonutData.series : [1];
			const labelsData = totalOrders > 0 ? data.chartDonutData.labels : ['Sin pedidos aún'];
			const colorsData = totalOrders > 0 ? data.chartDonutData.colors : ['#e2e8f0'];

			const optionsDonut = {
				chart: {
					type: 'donut',
					height: 290,
					fontFamily: 'inherit',
					background: 'transparent',
				},
				theme: { mode: 'light' },
				colors: colorsData,
				labels: labelsData,
				series: seriesData,
				legend: {
					position: 'bottom',
					labels: {
						colors: '#334155',
						useSeriesColors: false,
					},
					fontSize: '12px',
					fontWeight: 600,
					markers: { radius: 12 },
				},
				dataLabels: {
					enabled: totalOrders > 0,
					formatter: (val: any) => Number(val).toFixed(1) + '%',
					style: {
						fontSize: '11px',
						fontWeight: 'bold',
						colors: ['#ffffff'],
					},
					dropShadow: { enabled: true, blur: 2, opacity: 0.5 },
				},
				plotOptions: {
					pie: {
						donut: {
							size: '68%',
							labels: {
								show: true,
								total: {
									show: true,
									label: 'Total Pedidos',
									color: '#64748b',
									fontSize: '13px',
									fontWeight: 600,
									formatter: () => String(totalOrders),
								},
								value: {
									show: true,
									color: '#0f172a',
									fontSize: '22px',
									fontWeight: 800,
								},
							},
						},
					},
				},
				stroke: { show: false },
				tooltip: {
					enabled: totalOrders > 0,
					theme: 'light',
					y: {
						formatter: (val: any) => `${val} pedido(s)`,
					},
				},
			};
			const chartDonut = new (ApexCharts as any)(donutEl, optionsDonut);
			chartDonut.render();
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initDashboardCharts);
	} else {
		initDashboardCharts();
	}
	document.addEventListener('astro:page-load', initDashboardCharts);
</script>
