---
import Layout from '../layouts/Layout.astro';
import StoreNav from '../components/landing/StoreNav.astro';
import StoreHeader from '../components/landing/StoreHeader.astro';
import StoreTicker from '../components/landing/StoreTicker.astro';
import StoreFooter from '../components/landing/StoreFooter.astro';
import ProductCard from '../components/landing/ProductCard.astro';
import { listCategorias } from '@/lib/categorias';
import { listSubcategorias } from '@/lib/subcategorias';
import { listProductos } from '@/lib/productos';
import {
	getTiendaConfig,
	getTiendaConfiguracion,
	getTiendaPersonalizacion,
	googleFontsHref,
	themeStyleVars,
} from '@/lib/tienda';

export const prerender = false;

const [config, configuracion, theme, categorias, subcategorias, productos] = await Promise.all([
	getTiendaConfig(),
	getTiendaConfiguracion(),
	getTiendaPersonalizacion(),
	listCategorias(),
	listSubcategorias(),
	listProductos(),
]);

const storeName = configuracion?.nombre_tienda || config.nombre_tienda || 'Demo Tienda';
const themeVars = themeStyleVars(theme);
const fontsHref = googleFontsHref(theme.fuente_titulos, theme.fuente_cuerpo);

const brand = {
	nombre: storeName,
	logoUrl: configuracion?.logo_url || config.logo_url || null,
	whatsapp: configuracion?.whatsapp || config.whatsapp || null,
	instagram: configuracion?.instagram || null,
	tiktok: configuracion?.tiktok || null,
	telefono: configuracion?.telefono || null,
	direccion: configuracion?.direccion || null,
	horario: configuracion?.horario || null,
	correo: configuracion?.correo || null,
	rif: configuracion?.rif || null,
};

const navCategorias = categorias
	.filter((cat) => cat.activo)
	.map((cat) => ({
		id: cat.id,
		nombre: cat.nombre,
		slug: cat.slug,
		subcategorias: subcategorias
			.filter((sub) => sub.activo && sub.categoria_id === cat.id)
			.map((sub) => ({ id: sub.id, nombre: sub.nombre, slug: sub.slug })),
	}));

const activos = productos.filter((producto) => producto.activo);
const tendencias = activos.filter((producto) => producto.es_tendencia);
const ofertas = activos.filter((producto) => producto.en_oferta && producto.precio_oferta > 0);

// Si no hay productos marcados explícitamente en tendencia, mostramos los primeros como destacados
const productosTendencia = tendencias.length > 0 ? tendencias : activos.slice(0, 4);
---

<Layout
	title="Inicio"
	storeName={storeName}
	logoUrl={brand.logoUrl}
	whatsapp={brand.whatsapp}
	storeAddress={brand.direccion}
	themeVars={themeVars}
	fontsHref={fontsHref}
>
	<StoreNav
		storeName={storeName}
		logoUrl={brand.logoUrl}
		categorias={navCategorias}
		ofertasCount={ofertas.length}
	/>

	<main class="smain">
		<!-- Encabezado Llamativo con Datos de la Empresa y Botones Sociales Condicionales -->
		<StoreHeader brand={brand} />

		<!-- Banda en Movimiento (Carrusel Infinito) con Horario y Avisos de la Tienda -->
		<StoreTicker horario={brand.horario} storeName={storeName} />

		<!-- Sección de Productos en Tendencia (Llamativa y Atractiva al Cargar /) -->
		{productosTendencia.length > 0 ? (
			<section class="strending" id="tendencias">
				<div class="strending__glow" aria-hidden="true"></div>
				<div class="strending__inner">
					<div class="strending__head">
						<div class="strending__title-box">
							<span class="strending__badge">
								<svg class="strending__badge-icon" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<polyline points="23 6 13.5 15.5 8.5 10.5 1 18"></polyline>
									<polyline points="17 6 23 6 23 12"></polyline>
								</svg>
								Más Vendido
							</span>
							<h2 class="strending__title">Productos en Tendencia</h2>
							<p class="strending__subtitle">
								Los favoritos de nuestros clientes con la mejor calidad y disponibilidad inmediata.
							</p>
						</div>
					</div>

					<div class="sgrid sgrid--trending">
						{productosTendencia.map((producto) => (
							<ProductCard producto={producto} />
						))}
					</div>
				</div>
			</section>
		) : null}

		<!-- Catálogo Completo con Filtros de Búsqueda Normal y por Precio -->
		<section class="ssec" id="todos">
			<div class="ssec__head">
				<div>
					<p class="ssec__kicker">Explora Nuestro Catálogo</p>
					<h2 class="ssec__title" data-store-title>Todos los productos</h2>
				</div>
				<span class="ssec__count" data-store-count>{activos.length}</span>
			</div>

			<!-- Botón Sticky flotante para Móvil (Solo la Lupa) -->
			<div class="sfilter-mobile-sticky-wrap">
				<button
					type="button"
					id="mobile-filter-lupa-btn"
					class="sfilter-mobile-lupa-btn"
					aria-label="Abrir filtros y búsqueda"
					title="Buscar y filtrar productos"
				>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<span id="mobile-filter-badge" class="sfilter-mobile-badge" hidden></span>
				</button>
			</div>

			<!-- Backdrop para modal de filtros en móvil -->
			<div class="sfilter-mobile-backdrop" id="mobile-filter-backdrop" hidden></div>

			<!-- BARRA DE FILTROS: Búsqueda Normal + Rango de Precios en Acordeón Sticky -->
			<div class="sfilter-bar" id="filtros">
				<!-- Encabezado de filtros para móvil -->
				<div class="sfilter-modal-head">
					<div class="sfilter-modal-title-box">
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<span class="sfilter-modal-title">Filtros y Búsqueda</span>
					</div>
					<button type="button" id="mobile-filter-close-btn" class="sfilter-modal-close-btn" aria-label="Cerrar filtros">
						✕
					</button>
				</div>

				<div class="sfilter-bar__top">
					<!-- Campo de Búsqueda Normal -->
					<div class="sfilter-search">
						<svg class="sfilter-search__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="search"
							id="search-input"
							class="sfilter-search__input"
							placeholder="Buscar por nombre, modelo o categoría..."
							autocomplete="off"
							aria-label="Buscar productos"
						/>
						<button
							type="button"
							id="search-clear-btn"
							class="sfilter-search__clear"
							aria-label="Borrar búsqueda"
							hidden
						>
							✕
						</button>
					</div>

					<!-- Acciones: Selector de Ordenación y Botón Acordeón de Filtros -->
					<div class="sfilter-bar__actions">
						<div class="sfilter-sort">
							<label for="sort-select" class="sfilter-sort__label">Ordenar:</label>
							<select id="sort-select" class="sfilter-sort__select" aria-label="Ordenar productos">
								<option value="default">Destacados</option>
								<option value="price-asc">Precio: Menor a Mayor</option>
								<option value="price-desc">Precio: Mayor a Menor</option>
								<option value="offers">Solo Ofertas</option>
							</select>
						</div>

						<button
							type="button"
							id="filter-accordion-toggle"
							class="sfilter-accordion-btn"
							aria-expanded="true"
							aria-controls="filter-accordion-content"
							title="Mostrar u ocultar filtros de precio"
						>
							<svg class="sfilter-accordion-btn__icon" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<line x1="4" y1="21" x2="4" y2="14"></line>
								<line x1="4" y1="10" x2="4" y2="3"></line>
								<line x1="12" y1="21" x2="12" y2="12"></line>
								<line x1="12" y1="8" x2="12" y2="3"></line>
								<line x1="20" y1="21" x2="20" y2="16"></line>
								<line x1="20" y1="12" x2="20" y2="3"></line>
								<line x1="1" y1="14" x2="7" y2="14"></line>
								<line x1="9" y1="8" x2="15" y2="8"></line>
								<line x1="17" y1="16" x2="23" y2="16"></line>
							</svg>
							<span>Filtros</span>
							<span id="filter-active-badge" class="sfilter-accordion-badge" hidden>1</span>
							<svg class="sfilter-accordion-btn__chevron" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>
					</div>
				</div>

				<!-- Contenido del Acordeón (Colapsable / Expandible) -->
				<div id="filter-accordion-content" class="sfilter-accordion" data-open="true">
					<div class="sfilter-accordion__inner">
						<!-- Filtros por Rango de Precios -->
						<div class="sfilter-price">
							<span class="sfilter-price__title">Filtrar por Precio:</span>
							<div class="sfilter-price__chips">
								<button type="button" class="sfilter-chip is-active" data-price-bracket="all">Todos</button>
								<button type="button" class="sfilter-chip" data-price-bracket="0-50">Hasta $50</button>
								<button type="button" class="sfilter-chip" data-price-bracket="50-150">$50 a $150</button>
								<button type="button" class="sfilter-chip" data-price-bracket="150-300">$150 a $300</button>
								<button type="button" class="sfilter-chip" data-price-bracket="300+">Más de $300</button>
							</div>

							<!-- Rango personalizado Mín / Máx -->
							<div class="sfilter-custom-price">
								<div class="sfilter-input-group">
									<span class="sfilter-input-prefix">$</span>
									<input
										type="number"
										id="price-min"
										class="sfilter-price-input"
										placeholder="Mín"
										min="0"
										step="1"
										aria-label="Precio mínimo"
									/>
								</div>
								<span class="sfilter-range-sep">—</span>
								<div class="sfilter-input-group">
									<span class="sfilter-input-prefix">$</span>
									<input
										type="number"
										id="price-max"
										class="sfilter-price-input"
										placeholder="Máx"
										min="0"
										step="1"
										aria-label="Precio máximo"
									/>
								</div>
								<button type="button" id="btn-reset-filters" class="sfilter-reset-btn" hidden>
									Limpiar filtros
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Botón Aplicar en móvil -->
				<div class="sfilter-modal-foot">
					<button type="button" id="mobile-filter-apply-btn" class="sfilter-modal-apply-btn">
						Ver productos (<span data-store-count-btn>{activos.length}</span>)
					</button>
				</div>
			</div>

			<!-- Grid del Catálogo de Productos -->
			<div class="sgrid" data-store-grid id="catalogo-grid">
				{activos.map((producto) => <ProductCard producto={producto} />)}
			</div>

			<!-- Estado Vacío Cuando no Coinciden los Filtros -->
			<div class="ssec__empty" data-store-empty hidden>
				<svg class="ssec__empty-svg" viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<h3 class="ssec__empty-title">No encontramos productos que coincidan</h3>
				<p class="ssec__empty-text">Prueba ajustando los términos de búsqueda o el rango de precios.</p>
				<button type="button" class="ssec__empty-btn" id="btn-empty-reset">
					Restablecer filtros y ver todo
				</button>
			</div>
		</section>

		<!-- Footer Completo, Decente y Profesional -->
		<StoreFooter brand={brand} categorias={navCategorias} />
	</main>
</Layout>

<script>
	// Elementos del DOM
	const cards = Array.from(document.querySelectorAll('#catalogo-grid [data-store-card]')).filter(
		(el): el is HTMLElement => el instanceof HTMLElement,
	);
	const empty = document.querySelector('[data-store-empty]');
	const count = document.querySelector('[data-store-count]');
	const title = document.querySelector('[data-store-title]');
	const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
	const searchClearBtn = document.getElementById('search-clear-btn');
	const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
	const priceChips = Array.from(document.querySelectorAll('[data-price-bracket]')).filter(
		(el): el is HTMLButtonElement => el instanceof HTMLButtonElement,
	);
	const priceMinInput = document.getElementById('price-min') as HTMLInputElement | null;
	const priceMaxInput = document.getElementById('price-max') as HTMLInputElement | null;
	const resetBtn = document.getElementById('btn-reset-filters');
	const emptyResetBtn = document.getElementById('btn-empty-reset');
	const catalogGrid = document.getElementById('catalogo-grid');
	const accordionToggle = document.getElementById('filter-accordion-toggle');
	const accordionContent = document.getElementById('filter-accordion-content');
	const filterBadge = document.getElementById('filter-active-badge');
	const mobileLupaBtn = document.getElementById('mobile-filter-lupa-btn');
	const mobileBackdrop = document.getElementById('mobile-filter-backdrop');
	const mobileCloseBtn = document.getElementById('mobile-filter-close-btn');
	const mobileApplyBtn = document.getElementById('mobile-filter-apply-btn');
	const filtersContainer = document.getElementById('filtros');
	const mobileBadge = document.getElementById('mobile-filter-badge');
	const btnCount = document.querySelector('[data-store-count-btn]');

	function toggleMobileFilters(open: boolean) {
		if (!filtersContainer) return;
		filtersContainer.classList.toggle('is-mobile-open', open);
		if (mobileBackdrop) {
			mobileBackdrop.hidden = !open;
		}
		if (open) {
			document.body.style.overflow = 'hidden';
			setTimeout(() => searchInput?.focus(), 150);
		} else {
			document.body.style.overflow = '';
		}
	}

	mobileLupaBtn?.addEventListener('click', () => toggleMobileFilters(true));
	mobileCloseBtn?.addEventListener('click', () => toggleMobileFilters(false));
	mobileBackdrop?.addEventListener('click', () => toggleMobileFilters(false));
	mobileApplyBtn?.addEventListener('click', () => toggleMobileFilters(false));

	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && filtersContainer?.classList.contains('is-mobile-open')) {
			toggleMobileFilters(false);
		}
	});

	// En dispositivos móviles (<=768px) colapsar el acordeón inicialmente para no ocupar pantalla
	if (window.innerWidth <= 768) {
		accordionContent?.setAttribute('data-open', 'false');
		accordionToggle?.setAttribute('aria-expanded', 'false');
	}

	accordionToggle?.addEventListener('click', () => {
		const isOpen = accordionContent?.getAttribute('data-open') === 'true';
		const nextState = !isOpen;
		accordionContent?.setAttribute('data-open', String(nextState));
		accordionToggle?.setAttribute('aria-expanded', String(nextState));
	});

	// Estado actual de filtros
	let currentFilter = 'all'; // 'all', 'ofertas', 'categoria:...', 'subcategoria:...'
	let currentSearch = '';
	let currentPriceBracket = 'all'; // 'all', '0-50', '50-150', '150-300', '300+'
	let currentPriceMin: number | null = null;
	let currentPriceMax: number | null = null;
	let currentSort = 'default';

	function updateFilterVisibility() {
		let visibleCount = 0;
		const query = currentSearch.toLowerCase().trim();

		for (const card of cards) {
			let matchCat = true;

			// Filtro de Categoría / Ofertas / Tendencias
			if (currentFilter === 'all') {
				matchCat = true;
			} else if (currentFilter === 'ofertas') {
				matchCat = card.dataset.offer === 'true';
			} else if (currentFilter === 'tendencias') {
				matchCat = card.dataset.trending === 'true';
			} else if (currentFilter.startsWith('categoria:')) {
				matchCat = card.dataset.cat === currentFilter.slice('categoria:'.length);
			} else if (currentFilter.startsWith('subcategoria:')) {
				matchCat = card.dataset.sub === currentFilter.slice('subcategoria:'.length);
			}

			// Filtro de Búsqueda Normal por Texto
			let matchSearch = true;
			if (query.length > 0) {
				const searchPool = (card.dataset.search || card.dataset.name || '').toLowerCase();
				matchSearch = searchPool.includes(query);
			}

			// Filtro por Precio
			let matchPrice = true;
			const price = Number(card.dataset.price) || 0;

			// Rango rápido de precios
			if (currentPriceBracket === '0-50' && price > 50) matchPrice = false;
			if (currentPriceBracket === '50-150' && (price < 50 || price > 150)) matchPrice = false;
			if (currentPriceBracket === '150-300' && (price < 150 || price > 300)) matchPrice = false;
			if (currentPriceBracket === '300+' && price < 300) matchPrice = false;

			// Entradas manuales de precio mínimo y máximo
			if (currentPriceMin !== null && price < currentPriceMin) matchPrice = false;
			if (currentPriceMax !== null && price > currentPriceMax) matchPrice = false;

			const isVisible = matchCat && matchSearch && matchPrice;
			card.hidden = !isVisible;
			if (isVisible) visibleCount += 1;
		}

		// Ordenación
		sortCards();

		// Actualización de contadores y estados vacíos
		if (empty instanceof HTMLElement) empty.hidden = visibleCount > 0;
		if (count instanceof HTMLElement) count.textContent = String(visibleCount);
		if (btnCount instanceof HTMLElement) btnCount.textContent = String(visibleCount);

		// Mostrar / Ocultar badge de filtros de precio activos en el botón del acordeón
		const hasPriceFilter =
			currentPriceBracket !== 'all' ||
			currentPriceMin !== null ||
			currentPriceMax !== null;

		if (filterBadge instanceof HTMLElement) {
			filterBadge.hidden = !hasPriceFilter;
		}

		// Mostrar / Ocultar botón de Limpiar filtros si hay filtros activos
		const hasActiveFilters =
			currentSearch.length > 0 ||
			hasPriceFilter ||
			currentFilter !== 'all';

		if (resetBtn instanceof HTMLElement) {
			resetBtn.hidden = !hasActiveFilters;
		}

		if (mobileBadge instanceof HTMLElement) {
			mobileBadge.hidden = !hasActiveFilters;
		}

		if (searchClearBtn instanceof HTMLElement) {
			searchClearBtn.hidden = query.length === 0;
		}
	}

	function sortCards() {
		if (!catalogGrid) return;
		const visibleCards = cards.filter((c) => !c.hidden);

		if (currentSort === 'price-asc') {
			visibleCards.sort((a, b) => (Number(a.dataset.price) || 0) - (Number(b.dataset.price) || 0));
		} else if (currentSort === 'price-desc') {
			visibleCards.sort((a, b) => (Number(b.dataset.price) || 0) - (Number(a.dataset.price) || 0));
		} else if (currentSort === 'offers') {
			visibleCards.sort((a, b) => (b.dataset.offer === 'true' ? 1 : 0) - (a.dataset.offer === 'true' ? 1 : 0));
		}

		visibleCards.forEach((card, index) => {
			card.style.order = String(index);
		});
	}

	function resetAllFilters() {
		currentSearch = '';
		currentPriceBracket = 'all';
		currentPriceMin = null;
		currentPriceMax = null;
		currentSort = 'default';

		if (searchInput) searchInput.value = '';
		if (priceMinInput) priceMinInput.value = '';
		if (priceMaxInput) priceMaxInput.value = '';
		if (sortSelect) sortSelect.value = 'default';

		priceChips.forEach((chip) => {
			chip.classList.toggle('is-active', chip.dataset.priceBracket === 'all');
		});

		updateFilterVisibility();
	}

	// 1. Eventos de Búsqueda Normal
	searchInput?.addEventListener('input', () => {
		currentSearch = searchInput.value;
		updateFilterVisibility();
	});

	searchClearBtn?.addEventListener('click', () => {
		if (searchInput) {
			searchInput.value = '';
			currentSearch = '';
			searchInput.focus();
			updateFilterVisibility();
		}
	});

	// 2. Eventos de Rango de Precios Rápido (Chips)
	priceChips.forEach((chip) => {
		chip.addEventListener('click', () => {
			priceChips.forEach((c) => c.classList.remove('is-active'));
			chip.classList.add('is-active');
			currentPriceBracket = chip.dataset.priceBracket || 'all';

			// Si el usuario selecciona un chip, limpia los inputs personalizados
			if (priceMinInput) priceMinInput.value = '';
			if (priceMaxInput) priceMaxInput.value = '';
			currentPriceMin = null;
			currentPriceMax = null;

			updateFilterVisibility();
		});
	});

	// 3. Entradas Manuales de Precio Mínimo y Máximo
	priceMinInput?.addEventListener('input', () => {
		const val = priceMinInput.value.trim();
		currentPriceMin = val === '' ? null : Number(val);
		priceChips.forEach((c) => c.classList.remove('is-active'));
		currentPriceBracket = 'all';
		updateFilterVisibility();
	});

	priceMaxInput?.addEventListener('input', () => {
		const val = priceMaxInput.value.trim();
		currentPriceMax = val === '' ? null : Number(val);
		priceChips.forEach((c) => c.classList.remove('is-active'));
		currentPriceBracket = 'all';
		updateFilterVisibility();
	});

	// 4. Selector de Ordenación
	sortSelect?.addEventListener('change', () => {
		currentSort = sortSelect.value;
		updateFilterVisibility();
	});

	// 5. Botones de Limpiar Filtros
	resetBtn?.addEventListener('click', resetAllFilters);
	emptyResetBtn?.addEventListener('click', () => {
		currentFilter = 'all';
		document.querySelectorAll('[data-nav-filter]').forEach((el) => {
			el.classList.toggle('is-active', el.getAttribute('data-nav-filter') === 'all');
		});
		if (title) title.textContent = 'Todos los productos';
		resetAllFilters();
	});

	// 6. Manejador Global de Clics (Navegación y Botón de Carrito Rápido)
	document.addEventListener('click', (event) => {
		const clicked = event.target;
		if (!(clicked instanceof Element)) return;

		// Botón de agregar rápido al carrito
		const addBtn = clicked.closest<HTMLButtonElement>('[data-card-add]');
		if (addBtn) {
			event.preventDefault();
			event.stopPropagation();

			const id = addBtn.dataset.id || '';
			const slug = addBtn.dataset.slug || '';
			const name = addBtn.dataset.name || '';
			const price = Number(addBtn.dataset.price) || 0;
			const stock = Number(addBtn.dataset.stock) || 1;
			const img = addBtn.dataset.img || null;

			window.dispatchEvent(
				new CustomEvent('confi-cart:add', {
					detail: {
						product: {
							id: `${id}__base`,
							productId: id,
							slug: slug,
							nombre: name,
							combinacion: 'Única',
							precio: price,
							imagenUrl: img,
							maxStock: stock,
						},
						quantity: 1,
						redirectToCatalog: false,
					},
				})
			);

			// Animación de feedback en el botón
			const originalHtml = addBtn.innerHTML;
			addBtn.innerHTML = '<span>✓ Listo</span>';
			addBtn.style.background = '#16a34a';
			setTimeout(() => {
				addBtn.innerHTML = originalHtml;
				addBtn.style.background = '';
			}, 1200);

			return;
		}

		// Enlaces de Filtro del Menú Lateral y Footer
		const link = clicked.closest('[data-nav-filter]');
		if (!(link instanceof HTMLElement)) return;

		event.preventDefault();

		const filter = link.dataset.navFilter || 'all';
		const targetId = link.dataset.navTarget || 'todos';

		document.querySelectorAll('[data-nav-filter]').forEach((el) => {
			el.classList.toggle('is-active', el === link);
		});

		// Navegación hacia Tendencias
		if (filter === 'tendencias') {
			const trendingSec = document.getElementById('tendencias');
			if (trendingSec) {
				trendingSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
				return;
			}
		}

		currentFilter = filter;
		if (title instanceof HTMLElement) {
			title.textContent = link.dataset.navLabel || (filter === 'ofertas' ? 'Ofertas Especiales' : 'Todos los productos');
		}

		updateFilterVisibility();

		const targetElement = document.getElementById(targetId);
		if (targetElement) {
			targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
		}
	});

	// 7. Carga inicial mediante Hash en URL (#tendencias, #ofertas, #cat-..., etc.)
	if (window.location.hash) {
		const hash = window.location.hash;
		if (hash === '#tendencias') {
			const trendingLink = document.querySelector('[data-nav-filter="tendencias"]');
			if (trendingLink instanceof HTMLElement) trendingLink.click();
		} else if (hash === '#ofertas') {
			const ofertasLink = document.querySelector('[data-nav-filter="ofertas"]');
			if (ofertasLink instanceof HTMLElement) ofertasLink.click();
		} else {
			const hashLink =
				document.querySelector(`[href="/${hash}"]`) ||
				document.querySelector(`[href="${hash}"]`);
			if (hashLink instanceof HTMLElement) {
				hashLink.click();
			}
		}
	}
</script>

