---
import Layout from "../layouts/Layout.astro";
import StoreNav from "../components/landing/StoreNav.astro";
import StoreHeader from "../components/landing/StoreHeader.astro";
import StoreTicker from "../components/landing/StoreTicker.astro";
import StoreFooter from "../components/landing/StoreFooter.astro";
import ProductCard from "../components/landing/ProductCard.astro";
import { listCategorias } from "@/lib/categorias";
import { listSubcategorias } from "@/lib/subcategorias";
import { listProductos } from "@/lib/productos";
import {
	getTiendaConfig,
	getTiendaConfiguracion,
	getTiendaPersonalizacion,
	googleFontsHref,
	themeStyleVars,
} from "@/lib/tienda";

export const prerender = false;

const [config, configuracion, theme, categorias, subcategorias, productos] =
	await Promise.all([
		getTiendaConfig(),
		getTiendaConfiguracion(),
		getTiendaPersonalizacion(),
		listCategorias(),
		listSubcategorias(),
		listProductos(),
	]);

const storeName =
	configuracion?.nombre_tienda || config.nombre_tienda || "Demo Tienda";
const themeVars = themeStyleVars(theme);
const fontsHref = googleFontsHref(theme.fuente_titulos, theme.fuente_cuerpo);

const brand = {
	nombre: storeName,
	logoUrl: configuracion?.logo_url || config.logo_url || null,
	whatsapp: configuracion?.whatsapp || config.whatsapp || null,
	instagram: configuracion?.instagram || null,
	tiktok: configuracion?.tiktok || null,
	telefono: configuracion?.telefono || null,
	direccion: configuracion?.direccion || null,
	horario: configuracion?.horario || null,
	correo: configuracion?.correo || null,
	rif: configuracion?.rif || null,
};

const navCategorias = categorias
	.filter((cat) => cat.activo)
	.map((cat) => ({
		id: cat.id,
		nombre: cat.nombre,
		slug: cat.slug,
		subcategorias: subcategorias
			.filter((sub) => sub.activo && sub.categoria_id === cat.id)
			.map((sub) => ({ id: sub.id, nombre: sub.nombre, slug: sub.slug })),
	}));

const activos = productos.filter((producto) => producto.activo);

// Agrupar productos por categoría (en el orden de las categorías activas)
const seccionesCategoria = categorias
	.filter((cat) => cat.activo)
	.map((cat) => ({
		cat,
		items: activos.filter((p) => p.categoria_id === cat.id),
	}))
	.filter((s) => s.items.length > 0);
const idsAgrupados = new Set(seccionesCategoria.flatMap((s) => s.items.map((p) => p.id)));
const sinCategoria = activos.filter((p) => !idsAgrupados.has(p.id));
const tendencias = activos.filter((producto) => producto.es_tendencia);
const ofertas = activos.filter(
	(producto) => producto.en_oferta && producto.precio_oferta > 0,
);

// Si no hay productos marcados explícitamente en tendencia, mostramos los primeros como destacados
const productosTendencia =
	tendencias.length > 0 ? tendencias : activos.slice(0, 4);

// Preparar diapositivas para el carrusel horizontal infinito de tendencias:
// Aseguramos un conjunto base de al menos 6 elementos y número par (para soportar 2 filas en móvil)
const baseTendencias = [...productosTendencia];
if (baseTendencias.length > 0) {
	while (baseTendencias.length < 6 || baseTendencias.length % 2 !== 0) {
		baseTendencias.push(...productosTendencia);
	}
}
// 3 conjuntos continuos para rotación infinita sin saltos: [Pre Clones, Principal, Post Clones]
const carouselTendencias =
	baseTendencias.length > 0
		? [...baseTendencias, ...baseTendencias, ...baseTendencias]
		: [];
const baseCount = baseTendencias.length;
const originalCount = productosTendencia.length;
---

<Layout
	title="Inicio"
	description="Catálogo online de CONFISERVICIO. Descubre gran variedad de confitería, víveres, bebidas y productos de alta calidad al mejor precio en San Cristóbal y Venezuela con entregas y envíos."
	canonical="https://confiservicio.com/"
	ogImage={brand.logoUrl || "https://confiservicio.com/favicon.png"}
	storeName={storeName}
	logoUrl={brand.logoUrl}
	whatsapp={brand.whatsapp}
	storeAddress={brand.direccion}
	themeVars={themeVars}
	fontsHref={fontsHref}
>
	<StoreNav
		storeName={storeName}
		logoUrl={brand.logoUrl}
		categorias={navCategorias}
		ofertasCount={ofertas.length}
		tasaBcv={configuracion?.tasa_bcv || config.tasa_bcv}
		tasaCop={configuracion?.tasa_cop || config.tasa_cop}
	/>

	<main class="smain">
		<!-- Hero Móvil 100vh: Head + Ticker + Tendencias ocupan la pantalla completa -->
		<div class="shero" id="hero-screen">
			<!-- Encabezado Llamativo con Datos de la Empresa y Botones Sociales Condicionales -->
			<StoreHeader brand={brand} />

			<!-- Banda en Movimiento (Carrusel Infinito) con Horario y Avisos de la Tienda -->
			<StoreTicker horario={brand.horario} storeName={storeName} />

			<!-- Sección de Productos en Tendencia (Carrusel Horizontal Infinito) -->
			{
				productosTendencia.length > 0 ? (
					<section class="strending" id="tendencias">
						<div class="strending__glow" aria-hidden="true" />
						<div class="strending__inner">
							<div class="strending__head">
								<div class="strending__title-box">
									<span class="strending__badge">
										<svg
											class="strending__badge-icon"
											viewBox="0 0 24 24"
											width="14"
											height="14"
											fill="none"
											stroke="currentColor"
											stroke-width="2.2"
											stroke-linecap="round"
											stroke-linejoin="round"
											aria-hidden="true"
										>
											<polyline points="23 6 13.5 15.5 8.5 10.5 1 18" />
											<polyline points="17 6 23 6 23 12" />
										</svg>
										Más Vendido
									</span>
									<h2 class="strending__title">
										Productos en Tendencia
									</h2>
									<p class="strending__subtitle">
										Los favoritos de nuestros clientes con la
										mejor calidad y disponibilidad inmediata.
									</p>
								</div>

								<!-- Controles de Flechas y Puntos Indicadores para PC -->
								<div class="strending__controls">
									<div
										class="strending__dots"
										id="trending-dots"
										aria-hidden="true"
									>
										{productosTendencia.map((_, i) => (
											<button
												type="button"
												class:list={[
													"strending__dot",
													{ "is-active": i === 0 },
												]}
												data-dot-index={i}
												aria-label={`Ir al producto ${i + 1}`}
											/>
										))}
									</div>

									<div class="strending__arrows">
										<button
											type="button"
											class="strending__arrow-btn strending__arrow-btn--prev"
											data-trending-prev
											aria-label="Ver producto anterior"
											title="Anterior"
										>
											<svg
												viewBox="0 0 24 24"
												width="18"
												height="18"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<polyline points="15 18 9 12 15 6" />
											</svg>
										</button>
										<button
											type="button"
											class="strending__arrow-btn strending__arrow-btn--next"
											data-trending-next
											aria-label="Ver producto siguiente"
											title="Siguiente"
										>
											<svg
												viewBox="0 0 24 24"
												width="18"
												height="18"
												fill="none"
												stroke="currentColor"
												stroke-width="2.5"
												stroke-linecap="round"
												stroke-linejoin="round"
												aria-hidden="true"
											>
												<polyline points="9 18 15 12 9 6" />
											</svg>
										</button>
									</div>
								</div>
							</div>

							<!-- Carrusel Infinito con Gestos Táctiles y Flechas -->
							<div
								class="strending__carousel"
								id="trending-carousel"
								role="region"
								aria-label="Carrusel de productos en tendencia"
							>
								<!-- Flechas Flotantes Laterales para PC -->
								<button
									type="button"
									class="strending__side-arrow strending__side-arrow--prev"
									data-trending-prev
									aria-label="Producto anterior"
									title="Anterior"
								>
									<svg
										viewBox="0 0 24 24"
										width="22"
										height="22"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<polyline points="15 18 9 12 15 6" />
									</svg>
								</button>

								<button
									type="button"
									class="strending__side-arrow strending__side-arrow--next"
									data-trending-next
									aria-label="Producto siguiente"
									title="Siguiente"
								>
									<svg
										viewBox="0 0 24 24"
										width="22"
										height="22"
										fill="none"
										stroke="currentColor"
										stroke-width="2.5"
										stroke-linecap="round"
										stroke-linejoin="round"
										aria-hidden="true"
									>
										<polyline points="9 18 15 12 9 6" />
									</svg>
								</button>

								<!-- Track del Carrusel -->
								<div
									class="strending__track"
									id="trending-track"
									data-base-count={baseCount}
									data-original-count={originalCount}
								>
									{carouselTendencias.map((producto, idx) => (
										<div
											class="strending__slide"
											data-slide-index={idx}
											data-original-index={idx % originalCount}
										>
											<ProductCard producto={producto} />
										</div>
									))}
								</div>
							</div>
						</div>
					</section>
				) : null
			}
		</div>

		<!-- Catálogo Completo con Filtros de Búsqueda Normal y por Precio -->
		<section class="ssec" id="todos">
			<div class="ssec__head">
				<div>
					<p class="ssec__kicker">Explora Nuestro Catálogo</p>
					<h2 class="ssec__title" data-store-title>
						Todos los productos
					</h2>
				</div>
				<span class="ssec__count" data-store-count
					>{activos.length}</span
				>
			</div>

			<!-- Botón Sticky flotante para Móvil (Solo la Lupa) -->
			<div class="sfilter-mobile-sticky-wrap">
				<button
					type="button"
					id="mobile-filter-lupa-btn"
					class="sfilter-mobile-lupa-btn"
					aria-label="Abrir filtros y búsqueda"
					title="Buscar y filtrar productos"
				>
					<svg
						viewBox="0 0 24 24"
						width="20"
						height="20"
						fill="none"
						stroke="currentColor"
						stroke-width="2.3"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<span
						id="mobile-filter-badge"
						class="sfilter-mobile-badge"
						hidden></span>
				</button>
			</div>

			<!-- Backdrop para modal de filtros en móvil -->
			<div
				class="sfilter-mobile-backdrop"
				id="mobile-filter-backdrop"
				hidden
			>
			</div>

			<!-- BARRA DE FILTROS: Búsqueda Normal + Rango de Precios en Acordeón Sticky -->
			<div class="sfilter-bar" id="filtros">
				<!-- Encabezado de filtros para móvil -->
				<div class="sfilter-modal-head">
					<div class="sfilter-modal-title-box">
						<svg
							viewBox="0 0 24 24"
							width="18"
							height="18"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<span class="sfilter-modal-title"
							>Filtros y Búsqueda</span
						>
					</div>
					<button
						type="button"
						id="mobile-filter-close-btn"
						class="sfilter-modal-close-btn"
						aria-label="Cerrar filtros"
					>
						✕
					</button>
				</div>

				<div class="sfilter-bar__top">
					<!-- Campo de Búsqueda Normal -->
					<div class="sfilter-search">
						<svg
							class="sfilter-search__icon"
							viewBox="0 0 24 24"
							width="20"
							height="20"
							fill="none"
							stroke="currentColor"
							stroke-width="2.2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<circle cx="11" cy="11" r="8"></circle>
							<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
						</svg>
						<input
							type="search"
							id="search-input"
							class="sfilter-search__input"
							placeholder="Buscar por nombre, modelo o categoría..."
							autocomplete="off"
							aria-label="Buscar productos"
						/>
						<button
							type="button"
							id="search-clear-btn"
							class="sfilter-search__clear"
							aria-label="Borrar búsqueda"
							hidden
						>
							✕
						</button>
					</div>

					<!-- Acciones: Selector de Ordenación y Botón Acordeón de Filtros -->
					<div class="sfilter-bar__actions">
						<div class="sfilter-sort">
							<label for="sort-select" class="sfilter-sort__label"
								>Ordenar:</label
							>
							<select
								id="sort-select"
								class="sfilter-sort__select"
								aria-label="Ordenar productos"
							>
								<option value="default">Destacados</option>
								<option value="price-asc"
									>Precio: Menor a Mayor</option
								>
								<option value="price-desc"
									>Precio: Mayor a Menor</option
								>
								<option value="offers">Solo Ofertas</option>
							</select>
						</div>

						<button
							type="button"
							id="filter-accordion-toggle"
							class="sfilter-accordion-btn"
							aria-expanded="true"
							aria-controls="filter-accordion-content"
							title="Mostrar u ocultar filtros de precio"
						>
							<svg
								class="sfilter-accordion-btn__icon"
								viewBox="0 0 24 24"
								width="17"
								height="17"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<line x1="4" y1="21" x2="4" y2="14"></line>
								<line x1="4" y1="10" x2="4" y2="3"></line>
								<line x1="12" y1="21" x2="12" y2="12"></line>
								<line x1="12" y1="8" x2="12" y2="3"></line>
								<line x1="20" y1="21" x2="20" y2="16"></line>
								<line x1="20" y1="12" x2="20" y2="3"></line>
								<line x1="1" y1="14" x2="7" y2="14"></line>
								<line x1="9" y1="8" x2="15" y2="8"></line>
								<line x1="17" y1="16" x2="23" y2="16"></line>
							</svg>
							<span>Filtros</span>
							<span
								id="filter-active-badge"
								class="sfilter-accordion-badge"
								hidden>1</span
							>
							<svg
								class="sfilter-accordion-btn__chevron"
								viewBox="0 0 24 24"
								width="15"
								height="15"
								fill="none"
								stroke="currentColor"
								stroke-width="2.5"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
							>
								<polyline points="6 9 12 15 18 9"></polyline>
							</svg>
						</button>
					</div>
				</div>

				<!-- Contenido del Acordeón (Colapsable / Expandible) -->
				<div
					id="filter-accordion-content"
					class="sfilter-accordion"
					data-open="true"
				>
					<div class="sfilter-accordion__inner">
						<!-- Filtros por Rango de Precios -->
						<div class="sfilter-price">
							<span class="sfilter-price__title"
								>Filtrar por Precio:</span
							>
							<div class="sfilter-price__chips">
								<button
									type="button"
									class="sfilter-chip is-active"
									data-price-bracket="all">Todos</button
								>
								<button
									type="button"
									class="sfilter-chip"
									data-price-bracket="0-50">Hasta $50</button
								>
								<button
									type="button"
									class="sfilter-chip"
									data-price-bracket="50-150"
									>$50 a $150</button
								>
								<button
									type="button"
									class="sfilter-chip"
									data-price-bracket="150-300"
									>$150 a $300</button
								>
								<button
									type="button"
									class="sfilter-chip"
									data-price-bracket="300+"
									>Más de $300</button
								>
							</div>

							<!-- Rango personalizado Mín / Máx -->
							<div class="sfilter-custom-price">
								<div class="sfilter-input-group">
									<span class="sfilter-input-prefix">$</span>
									<input
										type="number"
										id="price-min"
										class="sfilter-price-input"
										placeholder="Mín"
										min="0"
										step="1"
										aria-label="Precio mínimo"
									/>
								</div>
								<span class="sfilter-range-sep">—</span>
								<div class="sfilter-input-group">
									<span class="sfilter-input-prefix">$</span>
									<input
										type="number"
										id="price-max"
										class="sfilter-price-input"
										placeholder="Máx"
										min="0"
										step="1"
										aria-label="Precio máximo"
									/>
								</div>
								<button
									type="button"
									id="btn-reset-filters"
									class="sfilter-reset-btn"
									hidden
								>
									Limpiar filtros
								</button>
							</div>
						</div>
					</div>
				</div>

				<!-- Botón Aplicar en móvil -->
				<div class="sfilter-modal-foot">
					<button
						type="button"
						id="mobile-filter-apply-btn"
						class="sfilter-modal-apply-btn"
					>
						Ver productos (<span data-store-count-btn
							>{activos.length}</span
						>)
					</button>
				</div>
			</div>

			<!-- Grid del Catálogo de Productos -->
			<div class="scatlist" id="catalogo-grid" data-store-grid>
				{seccionesCategoria.map(({ cat, items }) => (
					<section class="scat" id={`cat-${cat.id}`} data-cat-section>
						<header class:list={["scat__head", { "scat__head--noimg": !cat.imagen_url }]}>
							{cat.imagen_url ? (
								<img class="scat__bg" src={cat.imagen_url} alt="" loading="lazy" />
							) : null}
							<div class="scat__overlay" aria-hidden="true"></div>
							<div class="scat__info">
								<span class="scat__kicker">Categoría</span>
								<h3 class="scat__title">{cat.nombre}</h3>
							</div>
							<span class="scat__count">{items.length} {items.length === 1 ? "producto" : "productos"}</span>
						</header>
						<div class="sgrid">
							{items.map((producto) => <ProductCard producto={producto} />)}
						</div>
					</section>
				))}
				{sinCategoria.length > 0 && (
					<section class="scat" data-cat-section>
						<header class="scat__head scat__head--noimg">
							<div class="scat__overlay" aria-hidden="true"></div>
							<div class="scat__info">
								<span class="scat__kicker">Catálogo</span>
								<h3 class="scat__title">Otros productos</h3>
							</div>
							<span class="scat__count">{sinCategoria.length} {sinCategoria.length === 1 ? "producto" : "productos"}</span>
						</header>
						<div class="sgrid">
							{sinCategoria.map((producto) => <ProductCard producto={producto} />)}
						</div>
					</section>
				)}
			</div>

			<!-- Estado Vacío Cuando no Coinciden los Filtros -->
			<div class="ssec__empty" data-store-empty hidden>
				<svg
					class="ssec__empty-svg"
					viewBox="0 0 24 24"
					width="40"
					height="40"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<h3 class="ssec__empty-title">
					No encontramos productos que coincidan
				</h3>
				<p class="ssec__empty-text">
					Prueba ajustando los términos de búsqueda o el rango de
					precios
				</p>
				<button
					type="button"
					class="ssec__empty-btn"
					id="btn-empty-reset"
				>
					Restablecer filtros y ver todo
				</button>
			</div>
		</section>

		<!-- Footer Completo, Decente y Profesional -->
		<StoreFooter brand={brand} categorias={navCategorias} />
	</main>
</Layout>

<script>
	// Elementos del DOM
	const cards = Array.from(
		document.querySelectorAll("#catalogo-grid [data-store-card]"),
	).filter((el): el is HTMLElement => el instanceof HTMLElement);
	const empty = document.querySelector("[data-store-empty]");
	const count = document.querySelector("[data-store-count]");
	const title = document.querySelector("[data-store-title]");
	const searchInput = document.getElementById(
		"search-input",
	) as HTMLInputElement | null;
	const searchClearBtn = document.getElementById("search-clear-btn");
	const sortSelect = document.getElementById(
		"sort-select",
	) as HTMLSelectElement | null;
	const priceChips = Array.from(
		document.querySelectorAll("[data-price-bracket]"),
	).filter((el): el is HTMLButtonElement => el instanceof HTMLButtonElement);
	const priceMinInput = document.getElementById(
		"price-min",
	) as HTMLInputElement | null;
	const priceMaxInput = document.getElementById(
		"price-max",
	) as HTMLInputElement | null;
	const resetBtn = document.getElementById("btn-reset-filters");
	const emptyResetBtn = document.getElementById("btn-empty-reset");
	const catalogGrid = document.getElementById("catalogo-grid");
	const accordionToggle = document.getElementById("filter-accordion-toggle");
	const accordionContent = document.getElementById(
		"filter-accordion-content",
	);
	const filterBadge = document.getElementById("filter-active-badge");
	const mobileLupaBtn = document.getElementById("mobile-filter-lupa-btn");
	const mobileBackdrop = document.getElementById("mobile-filter-backdrop");
	const mobileCloseBtn = document.getElementById("mobile-filter-close-btn");
	const mobileApplyBtn = document.getElementById("mobile-filter-apply-btn");
	const filtersContainer = document.getElementById("filtros");
	const mobileBadge = document.getElementById("mobile-filter-badge");
	const btnCount = document.querySelector("[data-store-count-btn]");

	function toggleMobileFilters(open: boolean) {
		if (!filtersContainer) return;
		filtersContainer.classList.toggle("is-mobile-open", open);
		if (mobileBackdrop) {
			mobileBackdrop.hidden = !open;
		}
		if (open) {
			document.body.style.overflow = "hidden";
			setTimeout(() => searchInput?.focus(), 150);
		} else {
			document.body.style.overflow = "";
		}
	}

	mobileLupaBtn?.addEventListener("click", () => toggleMobileFilters(true));
	mobileCloseBtn?.addEventListener("click", () => toggleMobileFilters(false));
	mobileBackdrop?.addEventListener("click", () => toggleMobileFilters(false));
	mobileApplyBtn?.addEventListener("click", () => toggleMobileFilters(false));

	window.addEventListener("keydown", (e) => {
		if (
			e.key === "Escape" &&
			filtersContainer?.classList.contains("is-mobile-open")
		) {
			toggleMobileFilters(false);
		}
	});

	// En dispositivos móviles (<=768px) colapsar el acordeón inicialmente para no ocupar pantalla
	if (window.innerWidth <= 768) {
		accordionContent?.setAttribute("data-open", "false");
		accordionToggle?.setAttribute("aria-expanded", "false");
	}

	accordionToggle?.addEventListener("click", () => {
		const isOpen = accordionContent?.getAttribute("data-open") === "true";
		const nextState = !isOpen;
		accordionContent?.setAttribute("data-open", String(nextState));
		accordionToggle?.setAttribute("aria-expanded", String(nextState));
	});

	// Estado actual de filtros
	let currentFilter = "all"; // 'all', 'ofertas', 'categoria:...', 'subcategoria:...'
	let currentSearch = "";
	let currentPriceBracket = "all"; // 'all', '0-50', '50-150', '150-300', '300+'
	let currentPriceMin: number | null = null;
	let currentPriceMax: number | null = null;
	let currentSort = "default";

	function updateFilterVisibility() {
		let visibleCount = 0;
		const query = currentSearch.toLowerCase().trim();

		for (const card of cards) {
			let matchCat = true;

			// Filtro de Categoría / Ofertas / Tendencias
			if (currentFilter === "all") {
				matchCat = true;
			} else if (currentFilter === "ofertas") {
				matchCat = card.dataset.offer === "true";
			} else if (currentFilter === "tendencias") {
				matchCat = card.dataset.trending === "true";
			} else if (currentFilter.startsWith("categoria:")) {
				matchCat =
					card.dataset.cat ===
					currentFilter.slice("categoria:".length);
			} else if (currentFilter.startsWith("subcategoria:")) {
				matchCat =
					card.dataset.sub ===
					currentFilter.slice("subcategoria:".length);
			}

			// Filtro de Búsqueda Normal por Texto
			let matchSearch = true;
			if (query.length > 0) {
				const searchPool = (
					card.dataset.search ||
					card.dataset.name ||
					""
				).toLowerCase();
				matchSearch = searchPool.includes(query);
			}

			// Filtro por Precio
			let matchPrice = true;
			const price = Number(card.dataset.price) || 0;

			// Rango rápido de precios
			if (currentPriceBracket === "0-50" && price > 50)
				matchPrice = false;
			if (currentPriceBracket === "50-150" && (price < 50 || price > 150))
				matchPrice = false;
			if (
				currentPriceBracket === "150-300" &&
				(price < 150 || price > 300)
			)
				matchPrice = false;
			if (currentPriceBracket === "300+" && price < 300)
				matchPrice = false;

			// Entradas manuales de precio mínimo y máximo
			if (currentPriceMin !== null && price < currentPriceMin)
				matchPrice = false;
			if (currentPriceMax !== null && price > currentPriceMax)
				matchPrice = false;

			const isVisible = matchCat && matchSearch && matchPrice;
			card.hidden = !isVisible;
			if (isVisible) visibleCount += 1;
		}

		// Ocultar secciones de categoría sin productos visibles
		document.querySelectorAll<HTMLElement>("[data-cat-section]").forEach((sec) => {
			sec.hidden = !sec.querySelector("[data-store-card]:not([hidden])");
		});

		// Ordenación
		sortCards();

		// Actualización de contadores y estados vacíos
		if (empty instanceof HTMLElement) empty.hidden = visibleCount > 0;
		if (count instanceof HTMLElement)
			count.textContent = String(visibleCount);
		if (btnCount instanceof HTMLElement)
			btnCount.textContent = String(visibleCount);

		// Mostrar / Ocultar badge de filtros de precio activos en el botón del acordeón
		const hasPriceFilter =
			currentPriceBracket !== "all" ||
			currentPriceMin !== null ||
			currentPriceMax !== null;

		if (filterBadge instanceof HTMLElement) {
			filterBadge.hidden = !hasPriceFilter;
		}

		// Mostrar / Ocultar botón de Limpiar filtros si hay filtros activos
		const hasActiveFilters =
			currentSearch.length > 0 ||
			hasPriceFilter ||
			currentFilter !== "all";

		if (resetBtn instanceof HTMLElement) {
			resetBtn.hidden = !hasActiveFilters;
		}

		if (mobileBadge instanceof HTMLElement) {
			mobileBadge.hidden = !hasActiveFilters;
		}

		if (searchClearBtn instanceof HTMLElement) {
			searchClearBtn.hidden = query.length === 0;
		}
	}

	function sortCards() {
		if (!catalogGrid) return;
		const visibleCards = cards.filter((c) => !c.hidden);

		if (currentSort === "price-asc") {
			visibleCards.sort(
				(a, b) =>
					(Number(a.dataset.price) || 0) -
					(Number(b.dataset.price) || 0),
			);
		} else if (currentSort === "price-desc") {
			visibleCards.sort(
				(a, b) =>
					(Number(b.dataset.price) || 0) -
					(Number(a.dataset.price) || 0),
			);
		} else if (currentSort === "offers") {
			visibleCards.sort(
				(a, b) =>
					(b.dataset.offer === "true" ? 1 : 0) -
					(a.dataset.offer === "true" ? 1 : 0),
			);
		}

		visibleCards.forEach((card, index) => {
			card.style.order = String(index);
		});
	}

	function resetAllFilters() {
		currentSearch = "";
		currentPriceBracket = "all";
		currentPriceMin = null;
		currentPriceMax = null;
		currentSort = "default";

		if (searchInput) searchInput.value = "";
		if (priceMinInput) priceMinInput.value = "";
		if (priceMaxInput) priceMaxInput.value = "";
		if (sortSelect) sortSelect.value = "default";

		priceChips.forEach((chip) => {
			chip.classList.toggle(
				"is-active",
				chip.dataset.priceBracket === "all",
			);
		});

		updateFilterVisibility();
	}

	// 1. Eventos de Búsqueda Normal
	searchInput?.addEventListener("input", () => {
		currentSearch = searchInput.value;
		updateFilterVisibility();
	});

	searchClearBtn?.addEventListener("click", () => {
		if (searchInput) {
			searchInput.value = "";
			currentSearch = "";
			searchInput.focus();
			updateFilterVisibility();
		}
	});

	// 2. Eventos de Rango de Precios Rápido (Chips)
	priceChips.forEach((chip) => {
		chip.addEventListener("click", () => {
			priceChips.forEach((c) => c.classList.remove("is-active"));
			chip.classList.add("is-active");
			currentPriceBracket = chip.dataset.priceBracket || "all";

			// Si el usuario selecciona un chip, limpia los inputs personalizados
			if (priceMinInput) priceMinInput.value = "";
			if (priceMaxInput) priceMaxInput.value = "";
			currentPriceMin = null;
			currentPriceMax = null;

			updateFilterVisibility();
		});
	});

	// 3. Entradas Manuales de Precio Mínimo y Máximo
	priceMinInput?.addEventListener("input", () => {
		const val = priceMinInput.value.trim();
		currentPriceMin = val === "" ? null : Number(val);
		priceChips.forEach((c) => c.classList.remove("is-active"));
		currentPriceBracket = "all";
		updateFilterVisibility();
	});

	priceMaxInput?.addEventListener("input", () => {
		const val = priceMaxInput.value.trim();
		currentPriceMax = val === "" ? null : Number(val);
		priceChips.forEach((c) => c.classList.remove("is-active"));
		currentPriceBracket = "all";
		updateFilterVisibility();
	});

	// 4. Selector de Ordenación
	sortSelect?.addEventListener("change", () => {
		currentSort = sortSelect.value;
		updateFilterVisibility();
	});

	// 5. Botones de Limpiar Filtros
	resetBtn?.addEventListener("click", resetAllFilters);
	emptyResetBtn?.addEventListener("click", () => {
		currentFilter = "all";
		document.querySelectorAll("[data-nav-filter]").forEach((el) => {
			el.classList.toggle(
				"is-active",
				el.getAttribute("data-nav-filter") === "all",
			);
		});
		if (title) title.textContent = "Todos los productos";
		resetAllFilters();
	});

	// 6. Manejador Global de Clics (Navegación y Botón de Carrito Rápido)
	document.addEventListener("click", (event) => {
		const clicked = event.target;
		if (!(clicked instanceof Element)) return;

		// Botón de agregar rápido al carrito
		const addBtn = clicked.closest<HTMLButtonElement>("[data-card-add]");
		if (addBtn) {
			event.preventDefault();
			event.stopPropagation();

			const id = addBtn.dataset.id || "";
			const slug = addBtn.dataset.slug || "";
			const name = addBtn.dataset.name || "";
			const price = Number(addBtn.dataset.price) || 0;
			const stock = Number(addBtn.dataset.stock) || 1;
			const img = addBtn.dataset.img || null;

			window.dispatchEvent(
				new CustomEvent("confi-cart:add", {
					detail: {
						product: {
							id: `${id}__base`,
							productId: id,
							slug: slug,
							nombre: name,
							combinacion: "Única",
							precio: price,
							imagenUrl: img,
							maxStock: stock,
						},
						quantity: 1,
						redirectToCatalog: false,
					},
				}),
			);

			// Animación de feedback en el botón
			const originalHtml = addBtn.innerHTML;
			addBtn.innerHTML = "<span>✓ Listo</span>";
			addBtn.style.background = "#16a34a";
			setTimeout(() => {
				addBtn.innerHTML = originalHtml;
				addBtn.style.background = "";
			}, 1200);

			return;
		}

		// Enlaces de Filtro del Menú Lateral y Footer
		const link = clicked.closest("[data-nav-filter]");
		if (!(link instanceof HTMLElement)) return;

		event.preventDefault();

		const filter = link.dataset.navFilter || "all";
		const targetId = link.dataset.navTarget || "todos";

		document.querySelectorAll("[data-nav-filter]").forEach((el) => {
			el.classList.toggle("is-active", el === link);
		});

		// Navegación hacia Tendencias (sección pegada arriba, justo donde empieza)
		if (filter === "tendencias") {
			const trendingSec = document.getElementById("tendencias");
			if (trendingSec) {
				// Si el menú lateral móvil estaba abierto, restaurar overflow
				document.body.classList.remove("is-nav-open");
				document.body.style.overflow = "";

				const doScroll = () => {
					const mobileBar = document.querySelector(".snav__bar");
					const barHeight =
						mobileBar &&
						window.getComputedStyle(mobileBar).display !== "none"
							? mobileBar.getBoundingClientRect().height
							: 0;
					const targetY =
						trendingSec.getBoundingClientRect().top +
						window.scrollY -
						barHeight;
					window.scrollTo({
						top: Math.max(0, targetY),
						behavior: "smooth",
					});
				};

				doScroll();
				setTimeout(doScroll, 80);
				return;
			}
		}

		currentFilter = filter;
		if (title instanceof HTMLElement) {
			title.textContent =
				link.dataset.navLabel ||
				(filter === "ofertas"
					? "Ofertas Especiales"
					: "Todos los productos");
		}

		updateFilterVisibility();

		const targetElement = document.getElementById(targetId);
		if (targetElement) {
			// Restaurar scroll si el menú móvil estaba abierto
			document.body.classList.remove("is-nav-open");
			document.body.style.overflow = "";

			const doScroll = (smooth: boolean) => {
				const mobileBar = document.querySelector(".snav__bar");
				const barHeight =
					mobileBar &&
					window.getComputedStyle(mobileBar).display !== "none"
						? mobileBar.getBoundingClientRect().height
						: 0;
				const targetY =
					targetElement.getBoundingClientRect().top +
					window.scrollY -
					barHeight;
				window.scrollTo({
					top: Math.max(0, targetY),
					behavior: smooth ? "smooth" : "auto",
				});
			};

			// Esperar a que el layout se actualice tras filtrar y recalcular
			requestAnimationFrame(() => {
				doScroll(true);
				setTimeout(() => doScroll(false), 450);
			});
		}
	});

	// 7. Carga inicial mediante Hash en URL (#tendencias, #ofertas, #cat-..., etc.)
	if (window.location.hash) {
		const hash = window.location.hash;
		if (hash === "#tendencias") {
			const trendingLink = document.querySelector(
				'[data-nav-filter="tendencias"]',
			);
			if (trendingLink instanceof HTMLElement) trendingLink.click();
		} else if (hash === "#ofertas") {
			const ofertasLink = document.querySelector(
				'[data-nav-filter="ofertas"]',
			);
			if (ofertasLink instanceof HTMLElement) ofertasLink.click();
		} else {
			const hashLink =
				document.querySelector(`[href="/${hash}"]`) ||
				document.querySelector(`[href="${hash}"]`);
			if (hashLink instanceof HTMLElement) {
				hashLink.click();
			}
		}
	}

	// =========================================================================
	// 8. Carrusel Horizontal Infinito de Tendencias (Autoplay, Touch y Flechas)
	// =========================================================================
	const trendingCarousel = document.getElementById("trending-carousel");
	const trendingTrack = document.getElementById("trending-track");

	if (trendingCarousel && trendingTrack) {
		const baseCount = parseInt(trendingTrack.dataset.baseCount || "0", 10);
		const originalCount = parseInt(trendingTrack.dataset.originalCount || "1", 10);
		const slides = Array.from(trendingTrack.querySelectorAll<HTMLElement>(".strending__slide"));
		const prevBtns = Array.from(document.querySelectorAll<HTMLElement>("[data-trending-prev]"));
		const nextBtns = Array.from(document.querySelectorAll<HTMLElement>("[data-trending-next]"));
		const dots = Array.from(document.querySelectorAll<HTMLElement>(".strending__dot"));

		if (slides.length > 0 && baseCount > 0) {
			function getRowsCount(): number {
				if (slides.length < 2) return 1;
				const r0 = slides[0]?.getBoundingClientRect();
				const r1 = slides[1]?.getBoundingClientRect();
				if (r0 && r1 && Math.abs(r1.left - r0.left) < 6 && r1.top > r0.top + 10) {
					return 2;
				}
				return window.innerWidth <= 900 ? 2 : 1;
			}

			function getBaseCols(): number {
				const rows = getRowsCount();
				return Math.ceil(baseCount / rows);
			}

			function getSlideStep(): number {
				const rows = getRowsCount();
				const nextColIndex = rows === 2 && slides.length > 2 ? 2 : 1;
				const r0 = slides[0]?.getBoundingClientRect();
				const rNext = slides[nextColIndex]?.getBoundingClientRect();

				if (r0 && rNext && rNext.left > r0.left) {
					return rNext.left - r0.left;
				}

				if (r0 && r0.width > 0) {
					const isMobile = window.innerWidth <= 900;
					return r0.width + (isMobile ? 12 : 18);
				}

				return window.innerWidth <= 900 ? 190 : 338;
			}

			let currentIndex = getBaseCols(); // Iniciar en el juego central para loop infinito bidireccional
			let isAnimating = false;
			let autoplayTimer: ReturnType<typeof setInterval> | null = null;
			let resumeTimeout: ReturnType<typeof setTimeout> | null = null;
			let isHovered = false;
			let isDragging = false;
			let hasDragged = false;
			let startX = 0;
			let startY = 0;
			let currentX = 0;
			let currentY = 0;
			let startTranslate = 0;
			let isHorizontalSwipe = false;

			function updateDots() {
				if (dots.length === 0) return;
				const baseCols = getBaseCols();
				if (baseCols <= 0) return;
				const activeCol = ((currentIndex % baseCols) + baseCols) % baseCols;
				const activeDotIndex = activeCol % dots.length;
				dots.forEach((dot, idx) => {
					if (idx === activeDotIndex) {
						dot.classList.add("is-active");
						dot.setAttribute("aria-current", "true");
					} else {
						dot.classList.remove("is-active");
						dot.removeAttribute("aria-current");
					}
				});
			}

			const track: HTMLElement = trendingTrack;

			function goToSlide(index: number, animate = true) {
				currentIndex = index;
				const step = getSlideStep();
				const targetX = -currentIndex * step;

				if (animate) {
					track.style.transition = "transform 0.55s cubic-bezier(0.22, 1, 0.36, 1)";
					isAnimating = true;
				} else {
					track.style.transition = "none";
					isAnimating = false;
				}

				track.style.transform = `translate3d(${targetX}px, 0, 0)`;
				updateDots();
			}

			// Manejar reinicio transparente de posición para el loop infinito
			trendingTrack.addEventListener("transitionend", (e) => {
				if (e.target !== trendingTrack) return;
				isAnimating = false;

				const baseCols = getBaseCols();
				if (baseCols <= 0) return;
				// Si llegamos o sobrepasamos el conjunto de clones derecho
				if (currentIndex >= 2 * baseCols) {
					currentIndex = currentIndex - baseCols;
					goToSlide(currentIndex, false);
				}
				// Si llegamos o retrocedemos al conjunto de clones izquierdo
				else if (currentIndex < baseCols) {
					currentIndex = currentIndex + baseCols;
					goToSlide(currentIndex, false);
				}
			});

			// Posicionar inicialmente en el centro sin animación de inmediato y tras el primer frame
			goToSlide(currentIndex, false);
			requestAnimationFrame(() => {
				goToSlide(currentIndex, false);
			});
			window.addEventListener("load", () => {
				goToSlide(currentIndex, false);
			});

			// Recalcular posición si cambia el tamaño de pantalla
			window.addEventListener("resize", () => {
				const baseCols = getBaseCols();
				if (baseCols > 0 && (currentIndex >= 2 * baseCols || currentIndex < baseCols)) {
					currentIndex = baseCols;
				}
				goToSlide(currentIndex, false);
			});

			// --- Autoplay continuo cada 2 segundos ---
			function startAutoplay() {
				stopAutoplay();
				if (isHovered || isDragging) return;
				autoplayTimer = setInterval(() => {
					goToSlide(currentIndex + 1, true);
				}, 2000);
			}

			function stopAutoplay() {
				if (autoplayTimer) {
					clearInterval(autoplayTimer);
					autoplayTimer = null;
				}
			}

			function pauseAutoplayTemporarily(ms = 2500) {
				stopAutoplay();
				if (resumeTimeout) clearTimeout(resumeTimeout);
				resumeTimeout = setTimeout(() => {
					if (!isHovered && !isDragging) {
						startAutoplay();
					}
				}, ms);
			}

			startAutoplay();

			// Pausar al posar el cursor sobre el carrusel en PC
			trendingCarousel.addEventListener("mouseenter", () => {
				isHovered = true;
				stopAutoplay();
			});

			trendingCarousel.addEventListener("mouseleave", () => {
				isHovered = false;
				startAutoplay();
			});

			// Botones de flecha (PC)
			prevBtns.forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.preventDefault();
					pauseAutoplayTemporarily();
					goToSlide(currentIndex - 1, true);
				});
			});

			nextBtns.forEach((btn) => {
				btn.addEventListener("click", (e) => {
					e.preventDefault();
					pauseAutoplayTemporarily();
					goToSlide(currentIndex + 1, true);
				});
			});

			// Clic en los puntos indicadores (dots)
			dots.forEach((dot) => {
				dot.addEventListener("click", (e) => {
					e.preventDefault();
					const targetIndexAttr = dot.getAttribute("data-dot-index");
					if (targetIndexAttr !== null) {
						const targetIdx = parseInt(targetIndexAttr, 10);
						pauseAutoplayTemporarily();
						const baseCols = getBaseCols();
						const currentActive = ((currentIndex % baseCols) + baseCols) % baseCols;
						const diff = (targetIdx % baseCols) - currentActive;
						goToSlide(currentIndex + diff, true);
					}
				});
			});

			// --- Arrastre táctil con el dedo en Móvil ---
			trendingCarousel.addEventListener(
				"touchstart",
				(e) => {
					if (e.touches.length > 1) return;
					stopAutoplay();
					isDragging = true;
					hasDragged = false;
					isHorizontalSwipe = false;
					startX = e.touches[0].clientX;
					startY = e.touches[0].clientY;
					currentX = startX;
					currentY = startY;
					startTranslate = -currentIndex * getSlideStep();
					trendingTrack.style.transition = "none";
				},
				{ passive: true },
			);

			trendingCarousel.addEventListener(
				"touchmove",
				(e) => {
					if (!isDragging) return;
					currentX = e.touches[0].clientX;
					currentY = e.touches[0].clientY;
					const deltaX = currentX - startX;
					const deltaY = currentY - startY;

					if (!hasDragged && (Math.abs(deltaX) > 7 || Math.abs(deltaY) > 7)) {
						if (Math.abs(deltaX) >= Math.abs(deltaY)) {
							isHorizontalSwipe = true;
						}
					}

					if (isHorizontalSwipe) {
						hasDragged = true;
						if (e.cancelable) e.preventDefault();
						const currentTranslate = startTranslate + deltaX;
						trendingTrack.style.transform = `translate3d(${currentTranslate}px, 0, 0)`;
					}
				},
				{ passive: false },
			);

			const handleTouchEnd = () => {
				if (!isDragging) return;
				isDragging = false;
				const deltaX = currentX - startX;

				if (hasDragged && isHorizontalSwipe) {
					const threshold = 35;
					if (deltaX < -threshold) {
						goToSlide(currentIndex + 1, true);
					} else if (deltaX > threshold) {
						goToSlide(currentIndex - 1, true);
					} else {
						goToSlide(currentIndex, true);
					}
				} else {
					goToSlide(currentIndex, false);
				}

				pauseAutoplayTemporarily();
			};

			trendingCarousel.addEventListener("touchend", handleTouchEnd, { passive: true });
			trendingCarousel.addEventListener("touchcancel", handleTouchEnd, { passive: true });

			// --- Arrastre opcional con Mouse en PC ---
			let isMouseDown = false;
			trendingCarousel.addEventListener("mousedown", (e) => {
				if (e.button !== 0) return;
				stopAutoplay();
				isMouseDown = true;
				hasDragged = false;
				startX = e.clientX;
				currentX = startX;
				startTranslate = -currentIndex * getSlideStep();
				trendingTrack.style.transition = "none";
			});

			window.addEventListener("mousemove", (e) => {
				if (!isMouseDown) return;
				currentX = e.clientX;
				const deltaX = currentX - startX;
				if (Math.abs(deltaX) > 8) {
					hasDragged = true;
				}
				const currentTranslate = startTranslate + deltaX;
				trendingTrack.style.transform = `translate3d(${currentTranslate}px, 0, 0)`;
			});

			window.addEventListener("mouseup", () => {
				if (!isMouseDown) return;
				isMouseDown = false;
				const deltaX = currentX - startX;
				if (hasDragged) {
					if (deltaX < -35) {
						goToSlide(currentIndex + 1, true);
					} else if (deltaX > 35) {
						goToSlide(currentIndex - 1, true);
					} else {
						goToSlide(currentIndex, true);
					}
				}
				pauseAutoplayTemporarily(4000);
			});

			// Evitar que el clic abra accidentalmente la ficha si se estaba deslizando
			trendingCarousel.addEventListener(
				"click",
				(e) => {
					if (hasDragged) {
						e.preventDefault();
						e.stopPropagation();
						hasDragged = false;
					}
				},
				true,
			);

			// Recalcular tamaño exacto ante cambios de orientación o resize
			let resizeTimer: ReturnType<typeof setTimeout>;
			window.addEventListener("resize", () => {
				clearTimeout(resizeTimer);
				resizeTimer = setTimeout(() => {
					goToSlide(currentIndex, false);
				}, 120);
			});

			// Pausar si el usuario cambia de pestaña
			document.addEventListener("visibilitychange", () => {
				if (document.hidden) {
					stopAutoplay();
				} else if (!isHovered) {
					startAutoplay();
				}
			});
		}
	}

	// =========================================================================
	// 9. Actualización Multitasa Dinámica de Precios (USD, VES, COP)
	// =========================================================================
	function formatCurrencyPrice(valUSD: number, moneda: string, tasaBcv: number, tasaCop: number): string {
		const base = Number(valUSD) || 0;
		if (moneda === "VES") {
			const tasa = tasaBcv > 0 ? tasaBcv : 1;
			const enBs = base * tasa;
			return "Bs. " + new Intl.NumberFormat("es-VE", {
				minimumFractionDigits: 2,
				maximumFractionDigits: 2,
			}).format(enBs);
		}
		if (moneda === "COP") {
			const tasa = tasaCop > 0 ? tasaCop : 1;
			const enCop = Math.round(base * tasa);
			return "$ " + new Intl.NumberFormat("es-CO", {
				maximumFractionDigits: 0,
			}).format(enCop) + " COP";
		}
		return new Intl.NumberFormat("es-VE", {
			style: "currency",
			currency: "USD",
			minimumFractionDigits: 2,
		}).format(base);
	}

	function formatCurrencyRange(minUSD: number, maxUSD: number, moneda: string, tasaBcv: number, tasaCop: number): string {
		if (minUSD === maxUSD) return formatCurrencyPrice(minUSD, moneda, tasaBcv, tasaCop);
		const menor = Math.min(minUSD, maxUSD);
		const mayor = Math.max(minUSD, maxUSD);
		return `${formatCurrencyPrice(menor, moneda, tasaBcv, tasaCop)} – ${formatCurrencyPrice(mayor, moneda, tasaBcv, tasaCop)}`;
	}

	function applyCurrencyToCards(moneda: string, tasaBcv: number, tasaCop: number) {
		const allCards = document.querySelectorAll<HTMLElement>("[data-store-card]");
		allCards.forEach((card) => {
			const isRange = card.dataset.isRange === "true";
			const isOffer = card.dataset.isOffer === "true";

			const normMin = Number(card.dataset.priceNormalMin) || 0;
			const normMax = Number(card.dataset.priceNormalMax) || normMin;
			const offMin = Number(card.dataset.priceOfferMin) || 0;
			const offMax = Number(card.dataset.priceOfferMax) || offMin;

			const normalFormatted = isRange
				? formatCurrencyRange(normMin, normMax, moneda, tasaBcv, tasaCop)
				: formatCurrencyPrice(normMin, moneda, tasaBcv, tasaCop);

			const offerFormatted = isOffer
				? (isRange && offMin > 0
					? formatCurrencyRange(offMin, offMax, moneda, tasaBcv, tasaCop)
					: formatCurrencyPrice(offMin, moneda, tasaBcv, tasaCop))
				: "";

			const nowEl = card.querySelector<HTMLElement>("[data-card-price-now]");
			const oldEl = card.querySelector<HTMLElement>("[data-card-price-old]");

			if (nowEl) {
				nowEl.textContent = isOffer ? offerFormatted : normalFormatted;
			}
			if (oldEl && isOffer) {
				oldEl.textContent = normalFormatted;
			}
		});
	}

	// Escuchar evento de cambio de moneda emitido por CurrencySwitch
	window.addEventListener("confi-currency:change", (e: any) => {
		const { moneda, tasaBcv, tasaCop } = e.detail || {};
		if (moneda) {
			applyCurrencyToCards(moneda, Number(tasaBcv) || 0, Number(tasaCop) || 0);
		}
	});

	// Al cargar la página, chequear si ya había una moneda guardada
	try {
		const savedCurrency = localStorage.getItem("demo_tienda_moneda_activa");
		if (savedCurrency && savedCurrency !== "USD") {
			const sw = document.querySelector<HTMLElement>("[data-currency-switch]");
			const bcv = Number(sw?.dataset.tasaBcv) || 0;
			const cop = Number(sw?.dataset.tasaCop) || 0;
			applyCurrencyToCards(savedCurrency, bcv, cop);
		}
	} catch {
		// ignore
	}
</script>

