		overflow: hidden;
	}

	/* FILTROS DE PRECIO - Textos y Botones de Alto Contraste */
	.sfilter-price {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.85rem;
		padding-top: 1rem;
		margin-top: 0.85rem;
		border-top: 1px solid #e2e8f0;
	}

	.sfilter-price__title {
		font-size: 0.82rem;
		font-weight: 850;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #0f172a !important;
	}

	.sfilter-price__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.sfilter-chip {
		padding: 0.4rem 0.85rem;
		border-radius: 9999px;
		border: 1.5px solid #cbd5e1 !important;
		background: #f8fafc !important;
		color: #1e293b !important;
		font-size: 0.82rem;
		font-weight: 700;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.sfilter-chip:hover {
		border-color: #0f172a !important;
		color: #000000 !important;
		background: #e2e8f0 !important;
	}

	.sfilter-chip.is-active {
		background: #0f172a !important;
		color: var(--color-primario, #fff700) !important;
		border-color: #0f172a !important;
		font-weight: 900 !important;
		box-shadow: 0 3px 12px rgba(15, 23, 42, 0.35);
		text-shadow: 0 0 6px
			color-mix(in srgb, var(--color-primario, #fff700) 45%, transparent);
	}

	.sfilter-custom-price {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin-left: auto;
	}

	.sfilter-input-group {
		position: relative;
		display: flex;
		align-items: center;
	}

	.sfilter-input-prefix {
		position: absolute;
		left: 0.65rem;
		font-size: 0.85rem;
		font-weight: 800;
		color: #475569 !important;
		pointer-events: none;
		z-index: 3;
	}

	.sfilter-price-input {
		width: 5.6rem;
		padding: 0.45rem 0.5rem 0.45rem 1.45rem;
		border-radius: var(--radius-sm);
		border: 1.5px solid #cbd5e1 !important;
		background: #f8fafc !important;
		color: #0f172a !important;
		font-size: 0.85rem;
		font-weight: 700;
		font-family: inherit;
		transition: all 0.15s ease;
	}

	.sfilter-price-input:focus {
		outline: none;
		border-color: #0f172a !important;
		background: #ffffff !important;
	}

	.sfilter-range-sep {
		font-size: 0.85rem;
		color: #475569 !important;
		font-weight: 800;
	}

	.sfilter-reset-btn {
		padding: 0.45rem 0.95rem;
		border-radius: 9999px;
		border: 1.5px solid #f87171 !important;
		background: #fef2f2 !important;
		color: #b91c1c !important;
		font-size: 0.8rem;
		font-weight: 750;
		cursor: pointer;
		transition: all 0.15s ease;
	}

	.sfilter-reset-btn:hover {
		background: #fee2e2 !important;
		border-color: #ef4444 !important;
	}

	/* SECCIONES POR CATEGORÍA */
	.scatlist {
		display: flex;
		flex-direction: column;
		gap: 3rem;
	}
	.scat[hidden] {
		display: none;
	}
	.scat {
		scroll-margin-top: 5rem;
	}
	.scat__head {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		min-height: 11rem;
		padding: 1.5rem 1.75rem;
		margin-bottom: 1.5rem;
		border-radius: 1.5rem;
		color: #fff;
		background: linear-gradient(135deg, var(--color-primario, #4f46e5), var(--color-secundario, #9333ea));
		box-shadow: 0 14px 34px -12px rgba(0, 0, 0, 0.35);
	}
	.scat__head--noimg {
		min-height: 7rem;
		align-items: center;
	}
	.scat__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		z-index: -2;
		transition: transform 0.8s ease;
	}
	.scat__head:hover .scat__bg {
		transform: scale(1.06);
	}
	.scat__overlay {
		position: absolute;
		inset: 0;
		z-index: -1;
		background:
			linear-gradient(90deg, rgba(0, 0, 0, 0.78) 0%, rgba(0, 0, 0, 0.35) 55%, rgba(0, 0, 0, 0.1) 100%),
			linear-gradient(0deg, rgba(0, 0, 0, 0.45), transparent 60%);
	}
	.scat__head--noimg .scat__overlay {
		background: radial-gradient(circle at 85% 20%, rgba(255, 255, 255, 0.22), transparent 55%);
	}
	.scat__info {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}
	.scat__kicker {
		align-self: flex-start;
		padding: 0.2rem 0.65rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.2);
		backdrop-filter: blur(6px);
		border: 1px solid rgba(255, 255, 255, 0.35);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}
	.scat__title {
		margin: 0;
		font-size: clamp(1.7rem, 5vw, 2.8rem);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -0.02em;
		text-shadow: 0 3px 16px rgba(0, 0, 0, 0.45);
	}
	.scat__count {
		flex-shrink: 0;
		padding: 0.45rem 0.95rem;
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.95);
		color: #111;
		font-size: 0.8rem;
		font-weight: 800;
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.25);
	}
	@media (max-width: 600px) {
		.scat__head {
			min-height: 9rem;
			padding: 1.1rem;
			border-radius: 1.15rem;
			flex-direction: column;
			align-items: flex-start;
		}
	}

	/* GRIDS DE PRODUCTOS */
	.sgrid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(14.5rem, 1fr));
		gap: 1.35rem;
	}

	.sgrid--trending {
		grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
	}

	/* ESTADO VACÍO */
	.ssec__empty {
		padding: 3.5rem 1.5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		background: var(--panel);
		border: 1px dashed var(--line);
		border-radius: var(--radius-lg);
		color: var(--ink);
	}

	.ssec__empty-svg {
		color: color-mix(in srgb, var(--ink) 40%, transparent);
		margin-bottom: 0.25rem;
	}

	.ssec__empty-title {
		margin: 0;
		font-size: 1.2rem;
		font-weight: 800;
		color: var(--accent-ink);
	}

	.ssec__empty-text {
		margin: 0;
		font-size: 0.9rem;
		color: color-mix(in srgb, var(--ink) 65%, transparent);
		max-width: 25rem;
		color: var(--accent-ink);
	}

	.ssec__empty-btn {
		margin-top: 0.5rem;
		padding: 0.65rem 1.25rem;
		border-radius: 9999px;
		border: 0;
		background: var(--accent);
		color: var(--accent-ink);
		font-size: 0.85rem;
		font-weight: 750;
		cursor: pointer;
		box-shadow: 0 4px 14px
			color-mix(in srgb, var(--accent) 30%, transparent);
		transition: transform 0.15s ease;
	}

	.ssec__empty-btn:hover {
		transform: scale(1.03);
	}

	@media (max-width: 900px) {
		.smain {
			margin-left: 0;
			padding-top: var(--store-bar-h);
		}

		/* COMPORTAMIENTO MÓVIL: Head + Ticker + Tendencias con scroll natural y espacio desahogado */
		.shero {
			min-height: calc(100vh - var(--store-bar-h));
			min-height: calc(100dvh - var(--store-bar-h));
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			flex-shrink: 0;
			position: relative;
		}

		.shero :global(.shead) {
			flex-shrink: 0;
			padding: clamp(0.45rem, 1.5vh, 0.85rem) 1rem;
		}

		.shero :global(.sticker) {
			flex-shrink: 0;
		}

		.shero .strending {
			flex: 1 1 auto;
			min-height: calc(100vh - var(--store-bar-h));
			min-height: calc(100dvh - var(--store-bar-h));
			box-sizing: border-box;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: clamp(0.65rem, 1.8vh, 1rem) clamp(0.65rem, 3vw, 1rem);
			border-bottom: 1px solid var(--line);
			scroll-margin-top: var(--store-bar-h);
		}

		.shero .strending__inner {
			flex: 1 1 auto;
			min-height: 0;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			width: 100%;
			height: 100%;
		}

		.shero .strending__head {
			margin-top: 0.15rem;
			margin-bottom: clamp(0.35rem, 1vh, 0.6rem);
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			flex-shrink: 0;
		}

		.shero .strending__title-box {
			display: flex;
			align-items: center;
			gap: 0.55rem;
			flex-direction: row;
			flex-wrap: wrap;
		}

		.shero .strending__badge {
			padding: 0.22rem 0.55rem;
			font-size: 0.68rem;
			gap: 0.28rem;
			background: #16a34a !important;
			box-shadow: 0 4px 12px rgba(22, 163, 74, 0.4) !important;
		}

		.shero .strending__title {
			font-size: clamp(2rem, 9vw, 2.6rem);
			font-weight: 900;
			line-height: 1.1;
			flex: 1 1 100%;
			width: 100%;
		}

		.shero .strending__subtitle {
			display: none !important;
		}

		.shero .strending__controls {
			margin: 0;
		}

		/* En móvil se ocultan las flechas (el usuario mueve el carrusel con el dedo) */
		.strending__side-arrow,
		.strending__arrows {
			display: none !important;
		}

		.strending__carousel {
			flex: 1 1 auto;
			min-height: 0;
			display: flex;
			align-items: stretch;
			padding: 0.2rem 0;
			overflow: hidden;
			touch-action: pan-y;
		}

		.strending__track {
			display: grid !important;
			grid-template-rows: repeat(2, 1fr) !important;
			grid-auto-flow: column !important;
			grid-auto-columns: clamp(160px, 46vw, 215px) !important;
			gap: 0.6rem 0.75rem !important;
			align-items: stretch;
			height: 100%;
			min-height: 0;
			width: max-content;
		}

		.strending__slide {
			width: auto !important;
			max-width: none !important;
			flex: none !important;
			height: 100%;
			min-height: 0;
			display: flex;
			flex-direction: column;
		}

		.strending__slide :global(.scard) {
			height: 100%;
			min-height: 0;
			display: flex;
			flex-direction: column;
			border-radius: 1rem;
			border: 1.5px solid color-mix(in srgb, var(--line) 75%, #16a34a);
			box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
			background: var(--panel) !important;
			overflow: hidden;
		}

		.strending__slide :global(.scard__media) {
			flex: 0 0 auto;
			aspect-ratio: 16 / 10 !important;
			max-height: clamp(85px, 15vh, 135px) !important;
			background: var(--panel) !important;
			width: 100%;
			position: relative;
			overflow: hidden;
		}

		.strending__slide :global(.scard__img) {
			padding: 0.25rem;
			object-fit: contain;
		}

		.strending__slide :global(.scard__body) {
			flex: 1 1 auto;
			min-height: 0;
			display: flex;
			flex-direction: column;
			justify-content: space-between;
			padding: 0.5rem 0.65rem 0.6rem;
			gap: 0.2rem;
		}

		.strending__slide :global(.scard__cat) {
			font-size: 0.64rem;
			margin: 0;
			white-space: nowrap;
			overflow: hidden;
			text-overflow: ellipsis;
		}

		.strending__slide :global(.scard__name) {
			font-size: 0.8rem;
			font-weight: 750;
			line-height: 1.2;
			margin: 0;
			display: -webkit-box;
			-webkit-line-clamp: 2;
			-webkit-box-orient: vertical;
			overflow: hidden;
			min-height: calc(0.8rem * 1.2 * 2);
		}

		.strending__slide :global(.scard__foot) {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.35rem;
			margin-top: auto;
		}

		.strending__slide :global(.scard__price) {
			display: flex;
			flex-direction: column;
			gap: 0.1rem;
		}

		.strending__slide :global(.scard__price-now) {
			font-size: 0.95rem;
			font-weight: 850;
			line-height: 1.1;
		}

		.strending__slide :global(.scard__price-old) {
			font-size: 0.72rem;
		}

		.strending__slide :global(.scard__quick-add-btn) {
			width: 2rem;
			height: 2rem;
			flex-shrink: 0;
		}

		.sfilter-bar {
			top: calc(var(--store-bar-h) + 0.5rem);
			padding: 0.85rem 1rem;
		}

		.sfilter-bar__actions {
			width: 100%;
			justify-content: space-between;
		}

		.sfilter-custom-price {
			margin-left: 0;
			width: 100%;
		}

		.sgrid {
			grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
			gap: 0.85rem;
		}
	}

	/* RESPONSIVE MÓVIL: 2 Columnas y Lupa Sticky con Modal de Filtros */
	@media (max-width: 768px) {
		.ssec {
			padding: 1.5rem clamp(0.65rem, 3vw, 1.25rem) 1.5rem;
		}

		.ssec__head {
			margin-bottom: 0.85rem;
		}

		.sgrid {
			grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
			gap: 0.65rem;
		}

		/* Lupa flotante y Sticky en Móvil */
		.sfilter-mobile-sticky-wrap {
			display: flex;
			justify-content: flex-end;
			position: sticky;
			top: calc(var(--store-bar-h) + 0.5rem);
			z-index: 38;
			pointer-events: none;
			margin-bottom: 0.65rem;
		}

		.sfilter-mobile-lupa-btn {
			pointer-events: auto;
			position: relative;
			width: 2.75rem;
			height: 2.75rem;
			border-radius: 50%;
			background: #ffffff;
			border: 1.5px solid #cbd5e1;
			color: #0f172a;
			display: grid;
			place-items: center;
			box-shadow: 0 4px 16px rgba(0, 0, 0, 0.14);
			cursor: pointer;
			transition:
				transform 0.15s ease,
				background 0.15s ease,
				box-shadow 0.15s ease;
		}

		.sfilter-mobile-lupa-btn:active {
			transform: scale(0.92);
		}

		.sfilter-mobile-badge {
			position: absolute;
			top: 3px;
			right: 3px;
			width: 10px;
			height: 10px;
			border-radius: 50%;
			background: #ea580c;
			border: 2px solid #ffffff;
			box-shadow: 0 0 6px rgba(234, 88, 12, 0.5);
		}

		/* Fondo oscuro al abrir filtros */
		.sfilter-mobile-backdrop {
			display: block;
			position: fixed;
			inset: 0;
			background: rgba(15, 23, 42, 0.55);
			backdrop-filter: blur(4px);
			z-index: 48;
			animation: fadeInBackdrop 0.2s ease;
		}

		.sfilter-mobile-backdrop[hidden] {
			display: none !important;
		}

		/* Modal de Filtros en Móvil */
		.sfilter-bar {
			display: none !important;
		}

		.sfilter-bar.is-mobile-open {
			display: flex !important;
			position: fixed !important;
			inset: auto 0 0 0 !important;
			max-height: 85vh;
			border-radius: 1.25rem 1.25rem 0 0 !important;
			z-index: 50 !important;
			background: #ffffff !important;
			border: 0 !important;
			border-top: 1.5px solid #cbd5e1 !important;
			box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.3) !important;
			overflow-y: auto;
			-webkit-overflow-scrolling: touch;
			padding: 1.25rem 1.25rem
				calc(1.25rem + env(safe-area-inset-bottom, 0px)) !important;
			margin-bottom: 0 !important;
			animation: slideUpMobile 0.25s cubic-bezier(0.16, 1, 0.3, 1);
		}

		.sfilter-modal-head {
			display: flex;
			align-items: center;
			justify-content: space-between;
			margin-bottom: 1rem;
			padding-bottom: 0.75rem;
			border-bottom: 1px solid #e2e8f0;
		}

		.sfilter-modal-title-box {
			display: flex;
			align-items: center;
			gap: 0.5rem;
			color: #0f172a;
			font-family: var(--font-titulos);
			font-size: 1.05rem;
			font-weight: 800;
		}

		.sfilter-modal-close-btn {
			border: 0;
			background: #f1f5f9;
			color: #0f172a;
			width: 2rem;
			height: 2rem;
			border-radius: 50%;
			display: grid;
			place-items: center;
			font-size: 0.85rem;
			font-weight: 800;
			cursor: pointer;
			transition: background 0.15s ease;
		}

		.sfilter-modal-close-btn:active {
			background: #e2e8f0;
		}

		.sfilter-modal-foot {
			display: block;
			margin-top: 1.25rem;
			padding-top: 0.85rem;
			border-top: 1px solid #e2e8f0;
		}

		.sfilter-modal-apply-btn {
			width: 100%;
			padding: 0.85rem 1.25rem;
			border-radius: 9999px;
			border: 0;
			background: #0f172a;
			color: #ffffff;
			font-size: 0.92rem;
			font-weight: 800;
			cursor: pointer;
			box-shadow: 0 4px 14px rgba(15, 23, 42, 0.25);
			text-align: center;
			transition:
				transform 0.15s ease,
				background 0.15s ease;
		}

		.sfilter-modal-apply-btn:active {
			transform: scale(0.98);
		}
	}

	@media (max-width: 360px) {
		.ssec {
			padding-left: 0.5rem;
			padding-right: 0.5rem;
		}

		.sgrid {
			gap: 0.5rem;
		}
	}

	@keyframes fadeInBackdrop {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes slideUpMobile {
		from {
			transform: translateY(100%);
		}
		to {
			transform: translateY(0);
		}
	}

	/* FOOTER PROFESIONAL Y CORTO EN INDEX - FONDO CLARO */
	:global(.sfoot) {
		margin-top: 3rem !important;
		background: #ffffff !important;
		border-top: 1.5px solid #e2e8f0 !important;
		color: #334155 !important;
		box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.03) !important;
	}

	:global(.sfoot__container) {
		max-width: 78rem !important;
		margin: 0 auto !important;
		padding: 1.75rem clamp(1rem, 3.5vw, 2.5rem) 1.25rem !important;
	}

	:global(.sfoot__grid) {
		display: grid !important;
		grid-template-columns: 1.2fr 1.2fr 1.4fr !important;
		gap: 2.25rem !important;
		align-items: start !important;
		padding-bottom: 1.25rem !important;
	}

	:global(.sfoot__col--brand) {
		display: flex !important;
		flex-direction: column !important;
		gap: 0.65rem !important;
	}

	:global(.sfoot__brand-header) {
		display: flex !important;
		align-items: center !important;
		gap: 0.75rem !important;
	}

	:global(.sfoot__logo) {
		width: 2.6rem !important;
		height: 2.6rem !important;
		border-radius: 0.65rem !important;
		object-fit: cover !important;
		border: 1.5px solid #e2e8f0 !important;
		background: #f8fafc !important;
		flex-shrink: 0 !important;
	}

	:global(.sfoot__fallback) {
		display: grid !important;
		place-items: center !important;
		width: 2.6rem !important;
		height: 2.6rem !important;
		border-radius: 0.65rem !important;
		background: var(--color-primario, #0f766e) !important;
		color: var(--accent-ink, #ffffff) !important;
		font-family: var(--font-titulos, sans-serif) !important;
		font-size: 1.25rem !important;
		font-weight: 900 !important;
		flex-shrink: 0 !important;
	}

	:global(.sfoot__brand-title) {
		margin: 0 !important;
