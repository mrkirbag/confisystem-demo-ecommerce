---
import Layout from "../layouts/Layout.astro";
import {
	getTiendaConfig,
	getTiendaConfiguracion,
	getTiendaPersonalizacion,
	googleFontsHref,
	themeStyleVars,
} from "@/lib/tienda";

export const prerender = false;

const [config, configuracion, theme] = await Promise.all([
	getTiendaConfig(),
	getTiendaConfiguracion(),
	getTiendaPersonalizacion(),
]);

const storeName =
	configuracion?.nombre_tienda || config.nombre_tienda || "CONFISERVICIO";
const themeVars = themeStyleVars(theme);
const fontsHref = googleFontsHref(theme.fuente_titulos, theme.fuente_cuerpo);

const brand = {
	nombre: storeName,
	logoUrl: configuracion?.logo_url || config.logo_url || null,
};
---

<Layout
	title="404 · Página no encontrada"
	description="La página que buscas no existe o ha sido movida. Regresa al inicio de la tienda."
	storeName={storeName}
	logoUrl={brand.logoUrl}
	themeVars={themeVars}
	fontsHref={fontsHref}
	showCart={false}
>
	<main class="page-404">
		<!-- Elementos decorativos de fondo con desenfoque suave -->
		<div class="page-404__backdrop" aria-hidden="true">
			<div class="page-404__orb page-404__orb--1"></div>
			<div class="page-404__orb page-404__orb--2"></div>
		</div>

		<div class="page-404__container">
			<div class="page-404__card">
				<!-- Logo de la tienda -->
				{brand.logoUrl ? (
					<a href="/" class="page-404__brand-logo" title={`Ir al inicio de ${storeName}`}>
						<img src={brand.logoUrl} alt={storeName} />
					</a>
				) : (
					<a href="/" class="page-404__brand-text" title={`Ir al inicio de ${storeName}`}>
						<span>{storeName}</span>
					</a>
				)}

				<!-- Número 404 destacado -->
				<div class="page-404__graphic" aria-hidden="true">
					<span class="page-404__number">404</span>
				</div>

				<div class="page-404__content">
					<span class="page-404__badge">Error 404</span>
					<h1 class="page-404__title">Página no encontrada</h1>
					<p class="page-404__desc">
						La página o producto que estás buscando no existe, ha cambiado de lugar o fue removido.
					</p>

					<!-- Botón Ir al inicio -->
					<div class="page-404__actions">
						<a href="/" class="page-404__btn">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M3 9.5L12 3l9 6.5V20a1.5 1.5 0 0 1-1.5 1.5H4.5A1.5 1.5 0 0 1 3 20V9.5z"></path>
								<polyline points="9 21 9 12 15 12 15 21"></polyline>
							</svg>
							<span>Ir al inicio</span>
						</a>
					</div>
				</div>
			</div>
		</div>
	</main>
</Layout>

<style>
	:global(html, body) {
		overflow: hidden !important;
		height: 100% !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	.page-404 {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1.25rem;
		background: var(--color-fondo);
		overflow: hidden;
		box-sizing: border-box;
		z-index: 10;
	}

	.page-404__backdrop {
		position: absolute;
		inset: 0;
		pointer-events: none;
		overflow: hidden;
		z-index: 0;
	}

	.page-404__orb {
		position: absolute;
		border-radius: 50%;
		filter: blur(80px);
		opacity: 0.35;
	}

	.page-404__orb--1 {
		width: 320px;
		height: 320px;
		background: var(--color-primario);
		top: -80px;
		left: -80px;
	}

	.page-404__orb--2 {
		width: 380px;
		height: 380px;
		background: var(--color-primario);
		bottom: -100px;
		right: -100px;
	}

	.page-404__container {
		position: relative;
		z-index: 2;
		width: 100%;
		max-width: 480px;
		margin: 0 auto;
		display: flex;
		justify-content: center;
	}

	.page-404__card {
		width: 100%;
		background: var(--color-secundario);
		color: var(--color-texto);
		border: 1px solid color-mix(in srgb, var(--color-texto) 14%, var(--color-secundario));
		border-radius: 1.5rem;
		padding: 2.25rem 2rem 2.5rem;
		text-align: center;
		box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
		display: flex;
		flex-direction: column;
		align-items: center;
		box-sizing: border-box;
	}

	.page-404__brand-logo {
		display: inline-block;
		margin-bottom: 1rem;
		transition: transform 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
		line-height: 1;
	}

	.page-404__brand-logo:hover {
		transform: scale(1.03);
	}

	.page-404__brand-logo img {
		max-height: 48px;
		max-width: 180px;
		object-fit: contain;
		display: block;
		margin: 0 auto;
	}

	.page-404__brand-text {
		font-family: var(--font-titulos);
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--color-texto);
		margin-bottom: 1rem;
		letter-spacing: -0.01em;
	}

	.page-404__graphic {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		margin: 0.25rem 0 0.5rem;
		line-height: 1;
	}

	.page-404__number {
		font-family: var(--font-titulos);
		font-size: clamp(4.5rem, 13vw, 6.2rem);
		font-weight: 900;
		line-height: 0.95;
		letter-spacing: -0.05em;
		color: var(--color-primario);
		text-shadow: 0 4px 20px color-mix(in srgb, var(--color-primario) 30%, transparent);
		user-select: none;
	}

	.page-404__content {
		width: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.page-404__badge {
		display: inline-flex;
		align-items: center;
		font-size: 0.72rem;
		font-weight: 800;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		padding: 0.28rem 0.75rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-primario) 14%, var(--color-secundario));
		color: var(--color-primario);
		border: 1px solid color-mix(in srgb, var(--color-primario) 28%, transparent);
		margin-bottom: 0.65rem;
	}

	.page-404__title {
		font-family: var(--font-titulos);
		font-size: clamp(1.35rem, 3.2vw, 1.7rem);
		font-weight: 800;
		color: var(--color-texto);
		margin: 0 0 0.5rem 0;
		line-height: 1.25;
		letter-spacing: -0.02em;
	}

	.page-404__desc {
		font-size: 0.92rem;
		line-height: 1.55;
		color: color-mix(in srgb, var(--color-texto) 75%, transparent);
		max-width: 360px;
		margin: 0 auto 1.6rem auto;
	}

	.page-404__actions {
		display: flex;
		justify-content: center;
		width: 100%;
	}

	.page-404__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		padding: 0.85rem 2.2rem;
		border-radius: 999px;
		font-family: inherit;
		font-size: 0.95rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		text-decoration: none;
		background: var(--color-primario);
		color: var(--color-texto);
		border: 1.5px solid color-mix(in srgb, var(--color-texto) 22%, var(--color-primario));
		box-shadow: 0 6px 20px color-mix(in srgb, var(--color-primario) 36%, transparent);
		transition: all 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
		line-height: 1;
		cursor: pointer;
	}

	.page-404__btn svg {
		width: 1.15rem;
		height: 1.15rem;
		stroke: var(--color-texto);
		flex-shrink: 0;
	}

	.page-404__btn span {
		color: var(--color-texto);
	}

	.page-404__btn:hover {
		transform: translateY(-2px);
		box-shadow: 0 8px 24px color-mix(in srgb, var(--color-primario) 50%, transparent);
		filter: brightness(0.96);
	}

	.page-404__btn:active {
		transform: translateY(0);
	}

	@media (max-width: 640px) {
		.page-404 {
			padding: 1rem;
		}

		.page-404__card {
			padding: 2rem 1.25rem 2rem;
			border-radius: 1.25rem;
		}

		.page-404__btn {
			width: 100%;
			padding: 0.85rem 1.25rem;
		}
	}
</style>
