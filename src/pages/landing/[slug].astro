---
import Layout from "../../layouts/Layout.astro";
import StoreNav from "../../components/landing/StoreNav.astro";
import { listCategorias } from "@/lib/categorias";
import { listSubcategorias } from "@/lib/subcategorias";
import { getProductoBySlug } from "@/lib/productos";
import { listAtributos } from "@/lib/atributos";
import {
	COMBINACION_UNICA,
	descuentoPorcentaje,
	formatCombinacion,
	formatPrecio,
	formatStock,
	inferVarianteSeleccion,
	initialsFromName,
	parseCombinacion,
} from "@/lib/productos/shared";
import {
	getTiendaConfig,
	getTiendaConfiguracion,
	getTiendaPersonalizacion,
	googleFontsHref,
	themeStyleVars,
} from "@/lib/tienda";

export const prerender = false;

const slug = Astro.params.slug as string;

const [
	config,
	configuracion,
	theme,
	categorias,
	subcategorias,
	atributos,
	producto,
] = await Promise.all([
	getTiendaConfig(),
	getTiendaConfiguracion(),
	getTiendaPersonalizacion(),
	listCategorias(),
	listSubcategorias(),
	listAtributos(),
	getProductoBySlug(slug),
]);

if (!producto || !producto.activo) {
	return Astro.redirect("/");
}

const storeName =
	configuracion?.nombre_tienda || config.nombre_tienda || "Demo Tienda";
const themeVars = themeStyleVars(theme);
const fontsHref = googleFontsHref(theme.fuente_titulos, theme.fuente_cuerpo);

const brand = {
	nombre: storeName,
	logoUrl: configuracion?.logo_url || config.logo_url || null,
	whatsapp: configuracion?.whatsapp || config.whatsapp || null,
	instagram: configuracion?.instagram || null,
	tiktok: configuracion?.tiktok || null,
	telefono: configuracion?.telefono || null,
	direccion: configuracion?.direccion || null,
	horario: configuracion?.horario || null,
	correo: configuracion?.correo || null,
};

const storeInitial = storeName.trim().charAt(0).toUpperCase() || "D";

const navCategorias = categorias
	.filter((cat) => cat.activo)
	.map((cat) => ({
		id: cat.id,
		nombre: cat.nombre,
		slug: cat.slug,
		subcategorias: subcategorias
			.filter((sub) => sub.activo && sub.categoria_id === cat.id)
			.map((sub) => ({ id: sub.id, nombre: sub.nombre, slug: sub.slug })),
	}));

const inferred = inferVarianteSeleccion(producto.variantes, atributos);
const grupos = inferred.atributoIds
	.map((attrId) => {
		const atributo = atributos.find((row) => row.id === attrId);
		if (!atributo) return null;
		return {
			id: attrId,
			nombre: atributo.nombre,
			valores: inferred.opciones[attrId] ?? [],
		};
	})
	.filter(
		(group): group is { id: string; nombre: string; valores: string[] } =>
			Boolean(group),
	);

const preferred =
	producto.variantes.find((variante) => variante.stock > 0) ??
	producto.variantes[0];
const preferredParts = preferred ? parseCombinacion(preferred.combinacion) : [];

const picked: Record<string, string> = {};
for (const group of grupos) {
	const fromVariant = preferredParts.find(
		(part) => part.nombre === group.nombre,
	)?.valor;
	picked[group.id] = fromVariant || group.valores[0] || "";
}

const combinacion =
	grupos.length === 0
		? COMBINACION_UNICA
		: formatCombinacion(
				grupos.map((group) => ({
					nombre: group.nombre,
					valor: picked[group.id] || "",
				})),
			);

const parseParts = (comb: string) => {
	const map: Record<string, string> = {};
	if (!comb || comb === COMBINACION_UNICA) return map;
	comb.split(" / ").forEach((part) => {
		const idx = part.indexOf(": ");
		if (idx !== -1) {
			map[part.slice(0, idx).trim().toLowerCase()] = part
				.slice(idx + 2)
				.trim()
				.toLowerCase();
		}
	});
	return map;
};

const variante =
	grupos.length === 0
		? (producto.variantes[0] ?? null)
		: (producto.variantes.find((row) => {
				const vMap = parseParts(row.combinacion);
				return grupos.every((g) => {
					const targetVal = (picked[g.id] || "").trim().toLowerCase();
					const vVal = (vMap[g.nombre.trim().toLowerCase()] || "")
						.trim()
						.toLowerCase();
					return targetVal === vVal;
				});
			}) ??
			producto.variantes.find((row) => row.combinacion === combinacion) ??
			producto.variantes[0] ??
			null);

// LÓGICA COHERENTE DE PRECIOS (PRODUCTO, VARIANTES Y OFERTA)
const basePrice = Number(producto.precio_base) || 0;
const isByVariant = Boolean(producto.precio_por_variante);
const variantPrice =
	variante && isByVariant && Number(variante.precio) > 0
		? Number(variante.precio)
		: basePrice;

const offerActive = Boolean(producto.en_oferta);
const offerPrice = Number(producto.precio_oferta) || 0;
const hasOffer = offerActive && offerPrice > 0 && offerPrice < basePrice;

let regularPrice = variantPrice;
let salePrice = regularPrice;
let descuento = 0;

if (hasOffer) {
	if (regularPrice === basePrice) {
		salePrice = offerPrice;
	} else {
		const ratio = (basePrice - offerPrice) / basePrice;
		salePrice = Math.round(regularPrice * (1 - ratio) * 100) / 100;
	}
	if (regularPrice > salePrice) {
		descuento = Math.round((1 - salePrice / regularPrice) * 100);
	}
}

const esOferta = hasOffer && descuento > 0;
const listPrice = regularPrice;
const payPrice = salePrice;
const stock = variante?.stock ?? 0;
const disponible = stock > 0;
const agotado = producto.variantes.every((row) => row.stock <= 0);
const fotos = producto.imagenes ?? [];
const initials = initialsFromName(producto.nombre);

const extras = producto.detalles
	.map((detalle) => {
		const atributo = atributos.find(
			(row) => row.id === detalle.atributo_id,
		);
		if (!atributo) return null;
		return { nombre: atributo.nombre, valor: detalle.valor };
	})
	.filter((row): row is { nombre: string; valor: string } => Boolean(row));

const catLabel = producto.subcategoria_nombre
	? `${producto.categoria_nombre} / ${producto.subcategoria_nombre}`
	: producto.categoria_nombre;

const waNumber = brand.whatsapp;
const buildWaText = (nombre: string, combo: string, cantidad: number) => {
	const suffix = combo && combo !== COMBINACION_UNICA ? ` (${combo})` : "";
	return `Hola, me interesa comprar: ${nombre}${suffix} x${cantidad}`;
};
const waHref = waNumber
	? `https://wa.me/${waNumber}?text=${encodeURIComponent(buildWaText(producto.nombre, combinacion, 1))}`
	: null;

const waAskHref = waNumber
	? `https://wa.me/${waNumber}?text=${encodeURIComponent(`Hola, tengo una pregunta sobre: ${producto.nombre}`)}`
	: null;

const pdpData = {
	nombre: producto.nombre,
	slug: producto.slug,
	whatsapp: waNumber,
	precioBase: producto.precio_base,
	enOferta: producto.en_oferta,
	precioOferta: producto.precio_oferta,
	precioPorVariante: producto.precio_por_variante,
	combinacionUnica: COMBINACION_UNICA,
	grupos,
	variantes: producto.variantes.map((row) => ({
		combinacion: row.combinacion,
		stock: row.stock,
		sku: row.sku,
		precio: row.precio,
	})),
	fotos: fotos.map((img) => ({ url: img.url })),
};
const pdpDataJson = JSON.stringify(pdpData);
---

<Layout
	title={producto.nombre}
	storeName={storeName}
	logoUrl={brand.logoUrl}
	whatsapp={brand.whatsapp}
	storeAddress={brand.direccion}
	themeVars={themeVars}
	fontsHref={fontsHref}
>
	<StoreNav
		storeName={storeName}
		logoUrl={brand.logoUrl}
		categorias={navCategorias}
	/>

	<main class="page-pdp" id="top" data-pdp>
		<!-- BARRA SUPERIOR DE NAVEGACIÓN Y COMPARTIR -->
		<div class="pdp-nav-strip">
			<a href="/" class="pdp-back-btn" aria-label="Volver al catálogo">
				<svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
					<path
						fill-rule="evenodd"
						d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"
						clip-rule="evenodd"></path>
				</svg>
				<span>Volver al catálogo</span>
			</a>

			<nav class="pdp-breadcrumbs" aria-label="Ruta de navegación">
				<a href="/">Inicio</a>
				{
					producto.categoria_nombre && (
						<>
							<span class="sep">/</span>
							<a
								href={`/?categoria=${producto.categoria_nombre}`}
							>
								{producto.categoria_nombre}
							</a>
						</>
					)
				}
				{
					producto.subcategoria_nombre && (
						<>
							<span class="sep">/</span>
							<span class="current">
								{producto.subcategoria_nombre}
							</span>
						</>
					)
				}
			</nav>

			<div class="pdp-share-wrap">
				<button
					type="button"
					class="pdp-share-btn"
					data-pdp-share
					aria-label="Compartir este producto"
				>
					<svg
						viewBox="0 0 20 20"
						fill="currentColor"
						width="15"
						height="15"
						aria-hidden="true"
					>
						<path
							d="M15 8a3 3 0 10-2.977-2.63l-4.94 2.47a3 3 0 100 4.319l4.94 2.47a3 3 0 10.895-1.789l-4.94-2.47a3.027 3.027 0 000-.74l4.94-2.47C13.456 7.68 14.19 8 15 8z"
						></path>
					</svg>
					<span>Compartir</span>
				</button>
				<span class="pdp-share-toast" data-pdp-share-toast
					>¡Enlace copiado!</span
				>
			</div>
		</div>

		<!-- GRID PRINCIPAL DE PRODUCTO ESTILO MERCADO LIBRE -->
		<div class="pdp-main-grid">
			<!-- COLUMNA IZQUIERDA: SÓLO IMAGEN (FIJA EN PC, SCROLL NORMAL EN MÓVIL) -->
			<div
				class="pdp-box pdp-box-pad pdp-gallery-card"
				data-pdp-gallery-card
			>
				<!-- GALERÍA DE IMÁGENES -->
				<div class="pdp-gallery-wrap">
					{
						fotos.length > 1 && (
							<div
								class="pdp-thumbs-col"
								role="list"
								aria-label="Galería de fotos"
							>
								{fotos.map((img, index) => (
									<button
										type="button"
										role="listitem"
										class:list={[
											"pdp-thumb-item",
											{ "is-active": index === 0 },
										]}
										data-pdp-thumb
										aria-label={`Ver foto ${index + 1}`}
									>
										<img
											src={img.url}
											alt={`${producto.nombre} - foto ${index + 1}`}
											loading="lazy"
										/>
									</button>
								))}
							</div>
						)
					}

					<div
						class:list={[
							"pdp-hero-container",
							{ "is-sold-out": !disponible },
						]}
						data-pdp-hero
					>
						<div class="pdp-badge-stack">
							{
								producto.es_tendencia && (
									<span class="pdp-badge pdp-badge--trend">
										Más Vendido
									</span>
								)
							}
							{
								esOferta && (
									<span class="pdp-badge pdp-badge--sale">
										-{descuento}% OFF
									</span>
								)
							}
						</div>

						{
							fotos.length > 0 ? (
								<img
									data-pdp-hero-img
									class="pdp-hero-img"
									src={fotos[0].url}
									alt={producto.nombre}
									loading="eager"
								/>
							) : (
								<span class="pdp-hero-fallback">
									{initials}
								</span>
							)
						}

						<div
							class="pdp-hero-sold"
							data-pdp-sold
							hidden={disponible}
						>
							<span
								>{
									agotado ? "Agotado" : "Sin stock disponible"
								}</span
							>
						</div>

						{
							fotos.length > 0 && (
								<button
									type="button"
									class="pdp-zoom-trigger"
									data-pdp-zoom
									aria-label="Ampliar imagen completa"
								>
									<svg
										viewBox="0 0 24 24"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										width="18"
										height="18"
										aria-hidden="true"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
										/>
									</svg>
								</button>
							)
						}
					</div>
				</div>

				{
					fotos.length > 1 && (
						<div class="pdp-hero-dots" aria-hidden="true">
							{fotos.map((_, index) => (
								<span
									class:list={[
										"pdp-hero-dot",
										{ "is-active": index === 0 },
									]}
									data-pdp-dot
								/>
							))}
						</div>
					)
				}
			</div>

			<!-- COLUMNA DERECHA: ASIDE (BUY BOX + DESCRIPCIÓN Y SPECS + REPUTACIÓN DE LA TIENDA) -->
			<aside class="pdp-aside">
				<!-- CAJA DE COMPRA (BUY CARD) -->
				<div class="pdp-box pdp-buy-card">
					<!-- FILA DE ESTADO Y CALIFICACIÓN -->
					<div class="pdp-meta-row">
						<div
							class="pdp-rating"
							aria-label="Calificación 4.9 de 5"
						>
							<span class="pdp-stars">
								<svg viewBox="0 0 20 20" fill="currentColor"
									><path
										d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
									></path></svg
								>
								<svg viewBox="0 0 20 20" fill="currentColor"
									><path
										d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
									></path></svg
								>
								<svg viewBox="0 0 20 20" fill="currentColor"
									><path
										d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
									></path></svg
								>
								<svg viewBox="0 0 20 20" fill="currentColor"
									><path
										d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
									></path></svg
								>
								<svg viewBox="0 0 20 20" fill="currentColor"
									><path
										d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
									></path></svg
								>
							</span>
							<span>5.0</span>
						</div>
					</div>

					<!-- TÍTULO DEL PRODUCTO -->
					<h1 class="pdp-title">{producto.nombre}</h1>

					<!-- BLOQUE DE PRECIO -->
					<div class="pdp-price-wrap" data-pdp-price>
						<p
							class="pdp-price-old"
							data-pdp-price-old
							hidden={!esOferta}
						>
							{formatPrecio(listPrice)}
						</p>
						<div class="pdp-price-current-row">
							<span class="pdp-price-big" data-pdp-price-now>
								{formatPrecio(payPrice)}
							</span>
							<span
								class="pdp-save-badge"
								data-pdp-save
								hidden={!esOferta}
							>
								{descuento}% OFF
							</span>
						</div>
					</div>

					<!-- VARIANTES (COLOR, TALLA, MODELO, ETC.) -->
					{
						grupos.length > 0 && (
							<div class="pdp-variants-wrap">
								{grupos.map((group) => (
									<div class="pdp-variant-group">
										<div class="pdp-variant-label">
											<strong>{group.nombre}:</strong>
											<span data-pdp-selected={group.id}>
												{picked[group.id] || ""}
											</span>
										</div>
										<div
											class="pdp-variant-pills"
											role="group"
										>
											{group.valores.map((valor) => (
												<button
													type="button"
													class:list={[
														"pdp-variant-pill",
														{
															"is-active":
																picked[
																	group.id
																] === valor,
														},
													]}
													data-pdp-pick
													data-group-id={group.id}
													data-valor={valor}
												>
													{valor}
												</button>
											))}
										</div>
									</div>
								))}
							</div>
						)
					}

					<!-- STOCK Y CANTIDAD ESTILO MERCADO LIBRE -->
					<div class="pdp-stock-block">
						<div class="pdp-stock-header">
							<p class="pdp-stock-title">
								<span
									class:list={[
										"pdp-stock-dot",
										{ "is-out": !disponible },
									]}
									data-pdp-stock-dot></span>
								<span data-pdp-stock-title>
									{
										disponible
											? "Stock disponible"
											: "Sin stock disponible"
									}
								</span>
							</p>
						</div>

						<div
							class="pdp-stock-row"
							data-pdp-buy
							hidden={!disponible}
						>
							<div class="pdp-qty-line">
								<span class="pdp-qty-label">Cantidad:</span>
								<div class="pdp-qty-stepper">
									<button
										type="button"
										class="pdp-qty-btn"
										data-pdp-qty-minus
										aria-label="Restar una unidad"
										disabled
									>
										−
									</button>
									<span class="pdp-qty-number" data-pdp-qty
										>1</span
									>
									<button
										type="button"
										class="pdp-qty-btn"
										data-pdp-qty-plus
										aria-label="Sumar una unidad"
										disabled={stock <= 1}
									>
										+
									</button>
								</div>
								<span
									class="pdp-stock-count"
									data-pdp-stock-count
								>
									{
										disponible
											? stock === 1
												? "(¡Última disponible!)"
												: `(${formatStock(stock)} disponibles)`
											: ""
									}
								</span>
							</div>
						</div>
					</div>

					<!-- BOTONES DE COMPRA Y ACCIÓN -->
					<div
						class="pdp-actions-area"
						data-pdp-buy
						hidden={!disponible}
					>
						<button
							type="button"
							class="pdp-btn-cart"
							data-pdp-add-cart
							aria-label="Agregar al carrito y continuar comprando"
						>
							<svg
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2.2"
								aria-hidden="true"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
