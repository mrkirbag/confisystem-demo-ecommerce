</Layout>

<script define:vars={{ pdpDataJson }}>
	const state = {
		data: JSON.parse(pdpDataJson),
		picked: {},
		qty: 1,
		activePhotoIndex: 0,
	};
	const qs = (sel, ctx = document) => ctx.querySelector(sel);
	const qsa = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

	const formatMoney = (val) =>
		new Intl.NumberFormat("es-VE", {
			style: "currency",
			currency: "USD",
			minimumFractionDigits: 2,
		}).format(val);

	function getCombo() {
		return state.data.grupos.length === 0
			? state.data.combinacionUnica
			: state.data.grupos
					.map((g) => g.nombre + ": " + (state.picked[g.id] || ""))
					.join(" / ");
	}

	function parseCombo(comb) {
		const res = {};
		if (!comb || comb === state.data.combinacionUnica) return res;
		const parts = comb.split(" / ");
		for (const part of parts) {
			const idx = part.indexOf(": ");
			if (idx !== -1) {
				const k = part.slice(0, idx).trim().toLowerCase();
				const v = part
					.slice(idx + 2)
					.trim()
					.toLowerCase();
				res[k] = v;
			}
		}
		return res;
	}

	function findVariantForPicked(pickedMap) {
		if (state.data.grupos.length === 0) {
			return state.data.variantes[0] || null;
		}
		return (
			state.data.variantes.find((v) => {
				const vMap = parseCombo(v.combinacion);
				return state.data.grupos.every((g) => {
					const targetVal = (pickedMap[g.id] || "")
						.trim()
						.toLowerCase();
					const vVal = (vMap[g.nombre.trim().toLowerCase()] || "")
						.trim()
						.toLowerCase();
					return targetVal === vVal;
				});
			}) ||
			state.data.variantes.find((v) => {
				const c1 = (v.combinacion || "").normalize("NFC").toLowerCase();
				const c2 = getCombo().normalize("NFC").toLowerCase();
				return c1 === c2;
			}) ||
			state.data.variantes[0] ||
			null
		);
	}

	function getCurrentVariant() {
		return findVariantForPicked(state.picked);
	}

	function calculatePrice(v) {
		const basePrice = Number(state.data.precioBase) || 0;
		const isByVariant = Boolean(state.data.precioPorVariante);
		const variantPrice =
			v && isByVariant && Number(v.precio) > 0
				? Number(v.precio)
				: basePrice;

		const offerActive = Boolean(state.data.enOferta);
		const offerPrice = Number(state.data.precioOferta) || 0;
		const hasOffer =
			offerActive && offerPrice > 0 && offerPrice < basePrice;

		let regularPrice = variantPrice;
		let salePrice = regularPrice;
		let discount = 0;

		if (hasOffer) {
			if (regularPrice === basePrice) {
				salePrice = offerPrice;
			} else {
				const ratio = (basePrice - offerPrice) / basePrice;
				salePrice = Math.round(regularPrice * (1 - ratio) * 100) / 100;
			}
			if (regularPrice > salePrice) {
				discount = Math.round((1 - salePrice / regularPrice) * 100);
			}
		}

		return {
			regularPrice,
			salePrice,
			hasOffer: hasOffer && discount > 0,
			discount,
		};
	}

	function getWaLink(nombre, combo, qty) {
		if (!state.data.whatsapp) return null;
		const suffix =
			combo && combo !== state.data.combinacionUnica
				? " (" + combo + ")"
				: "";
		const text =
			"Hola, me interesa comprar: " + nombre + suffix + " x" + qty;
		return (
			"https://wa.me/" +
			state.data.whatsapp +
			"?text=" +
			encodeURIComponent(text)
		);
	}

	function init() {
		const container = qs("[data-pdp]");
		if (!container) return;

		state.data.grupos.forEach((group) => {
			const activeBtn = qs(
				'[data-pdp-pick][data-group-id="' + group.id + '"].is-active',
				container,
			);
			if (activeBtn) {
				state.picked[group.id] = activeBtn.getAttribute("data-valor");
			} else if (group.valores.length > 0) {
				state.picked[group.id] = group.valores[0];
			}
		});

		const qtyMinus = qs("[data-pdp-qty-minus]", container);
		const qtyPlus = qs("[data-pdp-qty-plus]", container);
		const qtyVal = qs("[data-pdp-qty]", container);
		const picks = qsa("[data-pdp-pick]", container);
		const cta = qs("[data-pdp-cta]", container);
		const mobCta = qs("[data-pdp-mob-cta]", container);
		const addCartBtn = qs("[data-pdp-add-cart]", container);
		const mobAddCartBtn = qs("[data-pdp-mob-add-cart]", container);

		picks.forEach((btn) => {
			btn.addEventListener("click", () => {
				const gid = btn.getAttribute("data-group-id");
				const val = btn.getAttribute("data-valor");
				if (state.picked[gid] === val) return;
				state.picked[gid] = val;
				qsa(
					'[data-pdp-pick][data-group-id="' + gid + '"]',
					container,
				).forEach((b) => {
					b.classList.remove("is-active");
				});
				btn.classList.add("is-active");
				const lbl = qs(`[data-pdp-selected="${gid}"]`, container);
				if (lbl) lbl.textContent = val;
				updateVariant();
			});
		});

		if (qtyMinus && qtyPlus && qtyVal) {
			qtyMinus.addEventListener("click", () => {
				if (state.qty > 1) {
					state.qty--;
					qtyVal.textContent = state.qty;
					qtyMinus.disabled = state.qty <= 1;
					qtyPlus.disabled = false;
					updateWaLink();
				}
			});
			qtyPlus.addEventListener("click", () => {
				const v = getCurrentVariant();
				const max = v ? Number(v.stock || 0) : 0;
				if (state.qty < max) {
					state.qty++;
					qtyVal.textContent = state.qty;
					qtyMinus.disabled = false;
					qtyPlus.disabled = state.qty >= max;
					updateWaLink();
				}
			});
		}

		function updateVariant() {
			const v = getCurrentVariant();
			const stock = v ? Number(v.stock || 0) : 0;
			const available = stock > 0;

			state.qty = Math.min(Math.max(1, state.qty), Math.max(1, stock));
			if (qtyVal) qtyVal.textContent = state.qty;
			if (qtyMinus) qtyMinus.disabled = state.qty <= 1;
			if (qtyPlus) qtyPlus.disabled = state.qty >= stock;

			const priceBlock = qs("[data-pdp-price]", container);
			if (priceBlock) {
				const info = calculatePrice(v);
				const nowEl = qs("[data-pdp-price-now]", priceBlock);
				const oldEl = qs("[data-pdp-price-old]", priceBlock);
				const saveEl = qs("[data-pdp-save]", priceBlock);
				const mobPrice = qs("[data-pdp-mob-price]", container);

				if (nowEl) nowEl.textContent = formatMoney(info.salePrice);
				if (mobPrice)
					mobPrice.textContent = formatMoney(info.salePrice);

				if (info.hasOffer) {
					if (oldEl) {
						oldEl.textContent = formatMoney(info.regularPrice);
						oldEl.hidden = false;
					}
					if (saveEl) {
						saveEl.textContent = info.discount + "% OFF";
						saveEl.hidden = false;
					}
				} else {
					if (oldEl) oldEl.hidden = true;
					if (saveEl) saveEl.hidden = true;
				}
			}

			const stockTitle = qs("[data-pdp-stock-title]", container);
			const stockDot = qs("[data-pdp-stock-dot]", container);
			const stockCount = qs("[data-pdp-stock-count]", container);

			if (stockTitle) {
				stockTitle.textContent = available
					? "Stock disponible"
					: "Sin stock disponible";
			}
			if (stockDot) {
				stockDot.classList.toggle("is-out", !available);
			}
			if (stockCount) {
				if (!available) {
					stockCount.textContent = "";
				} else if (stock === 1) {
					stockCount.textContent = "(¡Última disponible!)";
				} else {
					stockCount.textContent = `(${stock} disponibles)`;
				}
			}

			const buyEls = qsa("[data-pdp-buy]", container);
			const soldBox = qs("[data-pdp-sold-box]", container);
			const hero = qs("[data-pdp-hero]", container);
			const soldBadge = qs("[data-pdp-sold]", hero);

			buyEls.forEach((el) => {
				el.hidden = !available;
			});
			if (soldBox) soldBox.hidden = available;
			if (hero) hero.classList.toggle("is-sold-out", !available);
			if (soldBadge) soldBadge.hidden = available;
			if (mobCta) mobCta.hidden = !available;
			if (addCartBtn) addCartBtn.classList.toggle("is-disabled", !available);
			if (mobAddCartBtn) mobAddCartBtn.hidden = !available;

			updateWaLink();
			updatePickAvailability();
		}

		function handleAddToCart() {
			const v = getCurrentVariant();
			const stock = v ? Number(v.stock || 0) : 0;
			if (stock <= 0) {
				const toast = document.querySelector<HTMLElement>('[data-confi-toast]');
				const toastText = document.querySelector<HTMLElement>('[data-confi-toast-text]');
				if (toast && toastText) {
					toastText.textContent = "⚠️ Sin stock disponible para esta selección.";
					toast.classList.add("is-shown");
					setTimeout(() => toast.classList.remove("is-shown"), 3000);
				}
				return;
			}

			const priceInfo = calculatePrice(v);
			const comboLabel =
				v &&
				v.combinacion &&
				v.combinacion !== state.data.combinacionUnica
					? v.combinacion
					: getCombo();

			const variantKey = v ? (v.sku || v.combinacion || "base") : "base";
			const itemId = `${state.data.slug}__${variantKey}`;
			const firstPhoto = state.data.fotos.length > 0 ? state.data.fotos[0].url : null;

			window.dispatchEvent(
				new CustomEvent("confi-cart:add", {
					detail: {
						product: {
							id: itemId,
							productId: state.data.slug,
							slug: state.data.slug,
							nombre: state.data.nombre,
							combinacion: comboLabel,
							precio: priceInfo.salePrice,
							imagenUrl: firstPhoto,
							maxStock: stock,
						},
						quantity: state.qty,
						redirectToCatalog: true,
					},
				})
			);
		}

		if (addCartBtn) addCartBtn.addEventListener("click", handleAddToCart);
		if (mobAddCartBtn) mobAddCartBtn.addEventListener("click", handleAddToCart);

		function updateWaLink() {
			const v = getCurrentVariant();
			const comboLabel =
				v &&
				v.combinacion &&
				v.combinacion !== state.data.combinacionUnica
					? v.combinacion
					: getCombo();
			const href = getWaLink(state.data.nombre, comboLabel, state.qty);
			if (cta && cta.tagName === "A" && href) {
				cta.href = href;
			}
			if (mobCta && mobCta.tagName === "A" && href) {
				mobCta.href = href;
			}
		}

		function updatePickAvailability() {
			picks.forEach((btn) => {
				const gid = btn.getAttribute("data-group-id");
				const val = btn.getAttribute("data-valor");
				const testPicked = { ...state.picked, [gid]: val };
				const testV = findVariantForPicked(testPicked);
				if (!testV || testV.stock <= 0) {
					btn.classList.add("is-disabled");
				} else {
					btn.classList.remove("is-disabled");
				}
			});
		}

		const thumbs = qsa("[data-pdp-thumb]", container);
		const dots = qsa("[data-pdp-dot]", container);
		const heroImg = qs("[data-pdp-hero-img]", container);
		const mobThumb = qs("[data-pdp-mob-thumb]", container);

		function setPhoto(idx) {
			if (idx < 0 || idx >= state.data.fotos.length) return;
			state.activePhotoIndex = idx;
			const photoUrl = state.data.fotos[idx].url;

			if (heroImg) {
				heroImg.style.opacity = "0.4";
				setTimeout(() => {
					heroImg.src = photoUrl;
					heroImg.style.opacity = "1";
				}, 120);
			}
			if (mobThumb) {
				mobThumb.src = photoUrl;
			}

			thumbs.forEach((t, i) => {
				t.classList.toggle("is-active", i === idx);
				if (i === idx) {
					t.scrollIntoView({
						behavior: "smooth",
						block: "nearest",
						inline: "center",
					});
				}
			});
			dots.forEach((d, i) => d.classList.toggle("is-active", i === idx));
		}

		thumbs.forEach((t, i) => {
			t.addEventListener("click", () => setPhoto(i));
			t.addEventListener("mouseenter", () => setPhoto(i));
		});
		dots.forEach((d, i) => d.addEventListener("click", () => setPhoto(i)));

		// Lightbox
		const zoomBtn = qs("[data-pdp-zoom]", container);
		const lightbox = qs("[data-pdp-lightbox]");
		if (lightbox && heroImg) {
			const lbImg = qs("[data-pdp-lightbox-img]", lightbox);
			const closeLbs = qsa("[data-pdp-lightbox-close]", lightbox);
			const prevLb = qs("[data-pdp-lightbox-prev]", lightbox);
			const nextLb = qs("[data-pdp-lightbox-next]", lightbox);

			const openLb = () => {
				if (!lbImg || state.data.fotos.length === 0) return;
				lbImg.src = state.data.fotos[state.activePhotoIndex].url;
				lightbox.hidden = false;
				document.body.style.overflow = "hidden";
			};

			const closeLbFn = () => {
				lightbox.hidden = true;
				document.body.style.overflow = "";
			};

			if (zoomBtn) zoomBtn.addEventListener("click", openLb);
			heroImg.addEventListener("click", openLb);
			closeLbs.forEach((btn) => btn.addEventListener("click", closeLbFn));

			document.addEventListener("keydown", (e) => {
				if (lightbox.hidden) return;
				if (e.key === "Escape") closeLbFn();
				if (e.key === "ArrowLeft" && prevLb) prevLb.click();
				if (e.key === "ArrowRight" && nextLb) nextLb.click();
			});

			if (prevLb && nextLb) {
				prevLb.addEventListener("click", (e) => {
					e.stopPropagation();
					setPhoto(
						(state.activePhotoIndex - 1 + state.data.fotos.length) %
							state.data.fotos.length,
					);
					lbImg.src = state.data.fotos[state.activePhotoIndex].url;
				});
				nextLb.addEventListener("click", (e) => {
					e.stopPropagation();
					setPhoto(
						(state.activePhotoIndex + 1) % state.data.fotos.length,
					);
					lbImg.src = state.data.fotos[state.activePhotoIndex].url;
				});
			}
		}

		// Botón de Compartir
		const shareBtn = qs("[data-pdp-share]", container);
		const shareToast = qs("[data-pdp-share-toast]", container);
		if (shareBtn && shareToast) {
			shareBtn.addEventListener("click", async () => {
				try {
					if (navigator.clipboard) {
						await navigator.clipboard.writeText(
							window.location.href,
						);
					} else {
						const input = document.createElement("input");
						input.value = window.location.href;
						document.body.appendChild(input);
						input.select();
						document.execCommand("copy");
						document.body.removeChild(input);
					}
					shareToast.classList.add("is-shown");
					setTimeout(
						() => shareToast.classList.remove("is-shown"),
						2500,
					);
				} catch (err) {
					console.error("No se pudo copiar el enlace:", err);
				}
			});
		}

		// Mantener la imagen fija en PC incluso al final del scroll
		const galleryCard = qs("[data-pdp-gallery-card]", container);
		const mainGrid = qs(".pdp-main-grid", container);

		let cardLeft = 0;
		let cardWidth = 0;

		function updateCardDims() {
			if (!galleryCard || window.innerWidth <= 860) return;
			if (galleryCard.style.position !== "fixed") {
				const rect = galleryCard.getBoundingClientRect();
				cardLeft = rect.left;
				cardWidth = rect.width;
			} else if (mainGrid) {
				cardLeft = mainGrid.getBoundingClientRect().left;
			}
		}

		function syncStickyGallery() {
			if (!galleryCard || !mainGrid) return;

			if (window.innerWidth <= 860) {
				galleryCard.style.position = "";
				galleryCard.style.top = "";
				galleryCard.style.left = "";
				galleryCard.style.width = "";
				return;
			}

			const gridRect = mainGrid.getBoundingClientRect();
			const cardHeight = galleryCard.offsetHeight;
			const stickyTop = 24; // 1.5rem

			// Si el final del grid empujaría la imagen hacia arriba, fijarla permanentemente en pantalla
			if (gridRect.bottom <= stickyTop + cardHeight) {
				if (!cardLeft || !cardWidth) updateCardDims();
				galleryCard.style.position = "fixed";
				galleryCard.style.top = stickyTop + "px";
				galleryCard.style.left = cardLeft + "px";
				galleryCard.style.width = cardWidth + "px";
			} else {
				galleryCard.style.position = "";
				galleryCard.style.top = "";
				galleryCard.style.left = "";
				galleryCard.style.width = "";
				updateCardDims();
			}
		}

		window.addEventListener("scroll", syncStickyGallery, { passive: true });
		window.addEventListener("resize", () => {
			updateCardDims();
			syncStickyGallery();
		}, { passive: true });
		updateCardDims();
		syncStickyGallery();

		// Sincronizar estado inicial
		updateVariant();
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", init);
	} else {
		init();
	}
</script>
