---
interface BrandInfo {
	nombre: string;
	logoUrl: string | null;
	whatsapp: string | null;
	instagram: string | null;
	tiktok: string | null;
	telefono: string | null;
	direccion: string | null;
	horario: string | null;
	correo: string | null;
	rif?: string | null;
}

interface CategoriaItem {
	id: string;
	nombre: string;
	slug: string;
}

interface Props {
	brand: BrandInfo;
	categorias?: CategoriaItem[];
}

const { brand } = Astro.props;
const currentYear = new Date().getFullYear();
const initial = brand.nombre?.trim().charAt(0).toUpperCase() || 'D';

function cleanString(val: string | null | undefined): string | null {
	if (!val) return null;
	const trimmed = val.trim();
	return trimmed.length > 0 ? trimmed : null;
}

const cleanWhatsapp = cleanString(brand.whatsapp);
const cleanInstagram = cleanString(brand.instagram);
const cleanTiktok = cleanString(brand.tiktok);

const waHref = cleanWhatsapp
	? `https://wa.me/${cleanWhatsapp.replace(/[^\d+]/g, '')}?text=${encodeURIComponent(`Hola, me gustaría más información sobre ${brand.nombre}.`)}`
	: null;

const instagramHref = cleanInstagram
	? (cleanInstagram.startsWith('http://') || cleanInstagram.startsWith('https://')
		? cleanInstagram
		: `https://instagram.com/${cleanInstagram.replace(/^@/, '')}`)
	: null;

const tiktokHref = cleanTiktok
	? (cleanTiktok.startsWith('http://') || cleanTiktok.startsWith('https://')
		? cleanTiktok
		: `https://tiktok.com/@${cleanTiktok.replace(/^@/, '')}`)
	: null;

const cleanHorario = cleanString(brand.horario);
const cleanDireccion = cleanString(brand.direccion);
const cleanTelefono = cleanString(brand.telefono);
const cleanCorreo = cleanString(brand.correo);
const cleanRif = cleanString(brand.rif);

const hasSocials = Boolean(waHref || instagramHref || tiktokHref);
---

<footer class="sfoot" id="contacto">
	<div class="sfoot__container">
		<div class="sfoot__grid">
			<!-- Columna 1: Marca e Identidad -->
			<div class="sfoot__col sfoot__col--brand">
				<div class="sfoot__brand-header">
					{brand.logoUrl ? (
						<img class="sfoot__logo" src={brand.logoUrl} alt={brand.nombre} loading="lazy" />
					) : (
						<span class="sfoot__fallback">{initial}</span>
					)}
					<div class="sfoot__brand-text">
						<h3 class="sfoot__brand-title">{brand.nombre}</h3>
						{cleanRif ? <span class="sfoot__brand-rif">RIF: {cleanRif}</span> : null}
					</div>
				</div>
				<p class="sfoot__tagline">Catálogo oficial con atención personalizada y compras seguras.</p>
			</div>

			<!-- Columna 2: Atención y Horario -->
			<div class="sfoot__col sfoot__col--info">
				<h4 class="sfoot__heading">Atención</h4>
				<ul class="sfoot__list">
					{cleanHorario ? (
						<li class="sfoot__list-item">
							<svg class="sfoot__icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<circle cx="12" cy="12" r="10"></circle>
								<polyline points="12 6 12 12 16 14"></polyline>
							</svg>
							<span><strong>Horario:</strong> {cleanHorario}</span>
						</li>
					) : null}

					{cleanTelefono ? (
						<li class="sfoot__list-item">
							<svg class="sfoot__icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
							</svg>
							<a href={`tel:${cleanTelefono.replace(/\s+/g, '')}`} class="sfoot__link">{cleanTelefono}</a>
						</li>
					) : null}

					{cleanCorreo ? (
						<li class="sfoot__list-item">
							<svg class="sfoot__icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
							<a href={`mailto:${cleanCorreo}`} class="sfoot__link">{cleanCorreo}</a>
						</li>
					) : null}

					{cleanDireccion ? (
						<li class="sfoot__list-item">
							<svg class="sfoot__icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
								<circle cx="12" cy="10" r="3"></circle>
							</svg>
							<span>{cleanDireccion}</span>
						</li>
					) : null}
				</ul>
			</div>

			<!-- Columna 3: Redes Sociales y Formas de Pago -->
			<div class="sfoot__col sfoot__col--actions">
				{hasSocials ? (
					<div class="sfoot__social-section">
						<h4 class="sfoot__heading">Canales de Contacto</h4>
						<div class="sfoot__social-btns">
							{waHref ? (
								<a class="sfoot__social-btn sfoot__social-btn--wa" href={waHref} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp">
									<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
										<path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.39a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.9-4.44 9.9-9.9 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.8c2.16 0 4.2.84 5.73 2.37a8.06 8.06 0 0 1 2.37 5.73c0 4.47-3.64 8.1-8.1 8.1a8.1 8.1 0 0 1-4.13-1.13l-.3-.18-3.13.82.84-3.05-.2-.3a8.04 8.04 0 0 1-1.24-4.26c0-4.47 3.63-8.1 8.1-8.1zm-3.5 3.86c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64 2.03.87 2.44.7 2.88.65.44-.04 1.42-.58 1.62-1.14.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28-.24-.12-1.42-.7-1.64-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.01-.37-1.92-1.19-.71-.63-1.19-1.41-1.33-1.65-.14-.24-.02-.37.1-.49.11-.11.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.79-.2-.48-.4-.41-.54-.42l-.46-.01z"></path>
									</svg>
									<span>WhatsApp</span>
								</a>
							) : null}

							{instagramHref ? (
								<a class="sfoot__social-btn sfoot__social-btn--ig" href={instagramHref} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
									<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
										<path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"></path>
									</svg>
									<span>Instagram</span>
								</a>
							) : null}

							{tiktokHref ? (
								<a class="sfoot__social-btn sfoot__social-btn--tt" href={tiktokHref} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
									<svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
										<path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-1.01-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 2.89 3.5 2.76 1.44-.04 2.74-.98 3.19-2.35.25-.66.3-1.38.29-2.09.02-5.46-.01-10.92.02-16.38z"></path>
									</svg>
									<span>TikTok</span>
								</a>
							) : null}
						</div>
					</div>
				) : null}

				<!-- Medios de Pago -->
				<div class="sfoot__pay-section">
					<h4 class="sfoot__heading-sub">Medios de Pago</h4>
					<div class="sfoot__pay-badges">
						<span class="sfoot__pay-badge">Pago Móvil</span>
						<span class="sfoot__pay-badge">Transferencia</span>
						<span class="sfoot__pay-badge">Efectivo / Divisas</span>
						<span class="sfoot__pay-badge">Zelle</span>
					</div>
				</div>
			</div>
		</div>

		<!-- Barra Inferior Compacta -->
		<div class="sfoot__bottom">
			<p class="sfoot__copy">
				© {currentYear} <strong>{brand.nombre}</strong>. Todos los derechos reservados.
			</p>
			<span class="sfoot__status">
				<span class="sfoot__status-dot" aria-hidden="true"></span>
				<span>Catálogo Activo</span>
			</span>
		</div>
	</div>
</footer>
