---
interface BrandInfo {
	nombre: string;
	logoUrl: string | null;
	whatsapp: string | null;
	instagram: string | null;
	tiktok: string | null;
	telefono: string | null;
	direccion: string | null;
	horario: string | null;
	correo: string | null;
	rif?: string | null;
}

interface Props {
	brand: BrandInfo;
}

const { brand } = Astro.props;
const initial = brand.nombre?.trim().charAt(0).toUpperCase() || "D";

// Sanitización estricta: si está vacío o solo espacios, se considera nulo
function cleanString(val: string | null | undefined): string | null {
	if (!val) return null;
	const trimmed = val.trim();
	return trimmed.length > 0 ? trimmed : null;
}

const cleanWhatsapp = cleanString(brand.whatsapp);
const cleanInstagram = cleanString(brand.instagram);
const cleanTiktok = cleanString(brand.tiktok);

const waHref = cleanWhatsapp
	? `https://wa.me/${cleanWhatsapp.replace(/[^\d+]/g, "")}?text=${encodeURIComponent(`Hola, me interesa comprar en ${brand.nombre}.`)}`
	: null;

const instagramHref = cleanInstagram
	? cleanInstagram.startsWith("http://") ||
		cleanInstagram.startsWith("https://")
		? cleanInstagram
		: `https://instagram.com/${cleanInstagram.replace(/^@/, "")}`
	: null;

const tiktokHref = cleanTiktok
	? cleanTiktok.startsWith("http://") || cleanTiktok.startsWith("https://")
		? cleanTiktok
		: `https://tiktok.com/@${cleanTiktok.replace(/^@/, "")}`
	: null;

const cleanDireccion = cleanString(brand.direccion);
const cleanTelefono = cleanString(brand.telefono);
const cleanCorreo = cleanString(brand.correo);
---

<header class="shead" id="top">
	<div class="shead__bg-glow" aria-hidden="true"></div>

	<div class="shead__inner">
		<!-- Marca y Datos Principales -->
		<div class="shead__brand">
			<div class="shead__logo-wrapper">
				{
					brand.logoUrl ? (
						<img
							class="shead__logo"
							src={brand.logoUrl}
							alt={`Logo de ${brand.nombre}`}
							loading="eager"
						/>
					) : (
						<span class="shead__fallback" aria-hidden="true">
							{initial}
						</span>
					)
				}
			</div>

			<div class="shead__text">
				<h1 class="shead__name">{brand.nombre}</h1>
			</div>
		</div>
	</div>
</header>

<style>
	.shead {
		position: relative;
		overflow: hidden;
		padding: 1rem 1.5rem;
		background:
			radial-gradient(
				90% 120% at 85% 15%,
				color-mix(in srgb, var(--accent) 14%, transparent),
				transparent 60%
			),
			linear-gradient(
				135deg,
				color-mix(in srgb, var(--accent) 8%, var(--bg)),
				var(--bg) 70%
			);
		border-bottom: 1px solid var(--line);
		scroll-margin-top: var(--store-bar-h);
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.shead__bg-glow {
		position: absolute;
		top: -40%;
		right: -10%;
		width: 420px;
		height: 420px;
		border-radius: 50%;
		background: radial-gradient(
			circle,
			color-mix(in srgb, var(--accent) 18%, transparent) 0%,
			transparent 70%
		);
		filter: blur(45px);
		pointer-events: none;
		opacity: 0.7;
	}

	.shead__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		max-width: 78rem;
		margin: 0 auto;
	}

	.shead__brand {
		display: flex;
		align-items: center;
		gap: 1.15rem;
		min-width: 0;
	}

	.shead__logo-wrapper {
		position: relative;
		flex-shrink: 0;
	}

	.shead__logo {
		width: 3.6rem;
		height: 3.6rem;
		border-radius: 1rem;
		object-fit: cover;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
		border: 2px solid color-mix(in srgb, var(--panel) 90%, transparent);
		transition: transform 0.2s ease;
	}

	.shead__logo:hover {
		transform: scale(1.03);
	}

	.shead__fallback {
		display: grid;
		place-items: center;
		width: 3.6rem;
		height: 3.6rem;
		border-radius: 1rem;
		background: linear-gradient(
			135deg,
			var(--accent),
			color-mix(in srgb, var(--accent) 80%, #000)
		);
		color: var(--accent-ink);
		font-family: var(--font-titulos);
		font-size: 2.1rem;
		font-weight: 800;
		box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
	}

	.shead__text {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: 0;
	}

	.shead__name {
		margin: 0;
		font-family: var(--font-titulos);
		font-size: clamp(1.8rem, 4vw, 2.7rem);
		font-weight: 850;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: #ffffff;
		text-wrap: balance;
		text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
	}

	.shead__actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.65rem;
	}

	@media (max-width: 900px) {
		.shead {
			padding: clamp(0.35rem, 1.2vh, 0.65rem) 1rem;
		}

		.shead__brand {
			gap: 0.65rem;
		}

		.shead__logo,
		.shead__fallback {
			width: 2.35rem;
			height: 2.35rem;
			font-size: 1.15rem;
			border-radius: 0.65rem;
		}

		.shead__name {
			font-size: clamp(1.1rem, 3.4vw, 1.35rem);
		}

		.shead__actions {
			width: 100%;
			margin-top: 0.2rem;
		}
	}
</style>
