---
import { buildWhatsAppLink } from "@/lib/whatsapp";

interface BrandInfo {
	nombre: string;
	logoUrl: string | null;
	whatsapp: string | null;
	instagram: string | null;
	tiktok: string | null;
	telefono: string | null;
	direccion: string | null;
	horario: string | null;
	correo: string | null;
	rif?: string | null;
}

interface Props {
	brand: BrandInfo;
}

const { brand } = Astro.props;
const initial = brand.nombre?.trim().charAt(0).toUpperCase() || "D";

// Sanitización estricta: si está vacío o solo espacios, se considera nulo
function cleanString(val: string | null | undefined): string | null {
	if (!val) return null;
	const trimmed = val.trim();
	return trimmed.length > 0 ? trimmed : null;
}

const cleanWhatsapp = cleanString(brand.whatsapp);
const cleanInstagram = cleanString(brand.instagram);
const cleanTiktok = cleanString(brand.tiktok);

const waHref = buildWhatsAppLink(
	cleanWhatsapp,
	`Hola, me interesa comprar en ${brand.nombre}.`
);

const instagramHref = cleanInstagram
	? cleanInstagram.startsWith("http://") ||
		cleanInstagram.startsWith("https://")
		? cleanInstagram
		: `https://instagram.com/${cleanInstagram.replace(/^@/, "")}`
	: null;

const tiktokHref = cleanTiktok
	? cleanTiktok.startsWith("http://") || cleanTiktok.startsWith("https://")
		? cleanTiktok
		: `https://tiktok.com/@${cleanTiktok.replace(/^@/, "")}`
	: null;

const cleanDireccion = cleanString(brand.direccion);
const cleanHorario = cleanString(brand.horario);
const cleanTelefono = cleanString(brand.telefono);
const cleanCorreo = cleanString(brand.correo);
---

<header class="shead" id="top">
	<div class="shead__inner">
		<!-- Marca y Datos Principales Centrados (Logo arriba, nombre debajo) -->
		<div class="shead__brand">
			<div class="shead__logo-wrapper">
				{
					brand.logoUrl ? (
						<img
							class="shead__logo"
							src={brand.logoUrl}
							alt={`Logo de ${brand.nombre}`}
							loading="eager"
						/>
					) : (
						<span class="shead__fallback" aria-hidden="true">
							{initial}
						</span>
					)
				}
			</div>

			<div class="shead__text">
				<h1 class="shead__name">{brand.nombre}</h1>
			</div>
		</div>

		<!-- Información adicional: Horario y Ubicación a los lados con space-between -->
		<div class="shead__meta-bar">
			<div class="shead__meta-item shead__meta-item--hours">
				<svg
					class="shead__meta-icon"
					viewBox="0 0 24 24"
					width="17"
					height="17"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<circle cx="12" cy="12" r="10" />
					<polyline points="12 6 12 12 16 14" />
				</svg>
				<span class="shead__meta-text">
					{cleanHorario || "Lun–Sáb 9:00 AM - 6:00 PM"}
				</span>
			</div>

			<div class="shead__meta-item shead__meta-item--location">
				<svg
					class="shead__meta-icon"
					viewBox="0 0 24 24"
					width="17"
					height="17"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" />
					<circle cx="12" cy="10" r="3" />
				</svg>
				<span class="shead__meta-text" title={cleanDireccion || "Tienda física y envíos a nivel nacional"}>
					{cleanDireccion || "Envíos nacionales y retiro"}
				</span>
			</div>
		</div>
	</div>
</header>

<style>
	.shead {
		position: relative;
		overflow: hidden;
		padding: 1.6rem 1.5rem 1.15rem;
		background: var(--bg);
		border-bottom: 1px solid var(--line);
		scroll-margin-top: var(--store-bar-h);
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100%;
		box-sizing: border-box;
	}

	.shead__inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.85rem;
		width: 100%;
		max-width: 68rem;
		margin: 0 auto;
	}

	/* Logo centrado con el nombre debajo */
	.shead__brand {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.55rem;
		width: 100%;
	}

	.shead__logo-wrapper {
		position: relative;
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.shead__logo {
		width: 4rem;
		height: 4rem;
		border-radius: 1.1rem;
		object-fit: cover;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22), 0 0 0 1px color-mix(in srgb, var(--panel) 30%, transparent);
		border: 2px solid color-mix(in srgb, var(--panel) 90%, transparent);
		background: var(--panel);
		transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.shead__logo:hover {
		transform: scale(1.05);
	}

	.shead__fallback {
		display: grid;
		place-items: center;
		width: 4rem;
		height: 4rem;
		border-radius: 1.1rem;
		background: var(--accent);
		color: var(--accent-ink);
		font-family: var(--font-titulos);
		font-size: 2.2rem;
		font-weight: 850;
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
		border: 2px solid color-mix(in srgb, #fff 15%, transparent);
	}

	.shead__text {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.2rem;
		max-width: 90%;
	}

	.shead__name {
		margin: 0;
		font-family: var(--font-titulos);
		font-size: clamp(1.6rem, 3.2vw, 2.25rem);
		font-weight: 900;
		letter-spacing: -0.035em;
		line-height: 1.1;
		color: var(--ink);
		text-align: center;
		text-wrap: balance;
	}

	/* Ubicación y Horario uno al lado del otro con space-between */
	.shead__meta-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.25rem;
		width: 100%;
		padding-top: 0.65rem;
		border-top: 1px solid color-mix(in srgb, var(--line) 75%, transparent);
	}

	.shead__meta-item {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-size: clamp(0.85rem, 2vw, 0.95rem);
		font-weight: 500;
		color: var(--muted);
		line-height: 1.35;
	}

	.shead__meta-item--hours {
		text-align: left;
		justify-content: flex-start;
		max-width: 48%;
	}

	.shead__meta-item--location {
		text-align: right;
		justify-content: flex-end;
		max-width: 48%;
	}

	.shead__meta-icon {
		flex-shrink: 0;
		color: var(--accent);
		opacity: 0.95;
	}

	.shead__meta-text {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 900px) {
		.shead {
			padding: clamp(1.4rem, 3.5vh, 2rem) 1rem clamp(1.2rem, 3vh, 1.6rem);
		}

		.shead__inner {
			gap: 1.15rem;
		}

		.shead__brand {
			gap: 0.75rem;
		}

		.shead__logo,
		.shead__fallback {
			width: 4.25rem;
			height: 4.25rem;
			font-size: 2.2rem;
			border-radius: 1rem;
		}

		.shead__name {
			font-size: clamp(1.45rem, 5.2vw, 1.85rem);
		}

		.shead__meta-bar {
			padding-top: 0.75rem;
			gap: 0.75rem;
		}

		.shead__meta-item {
			font-size: 0.8rem;
			gap: 0.4rem;
		}

		.shead__meta-icon {
			width: 15px;
			height: 15px;
		}
	}

	@media (max-width: 480px) {
		.shead__meta-text {
			font-size: 0.76rem;
		}
	}
</style>
